qr:Medio_QR_FOT_2026_053_14 a qr:RegistroAudiovisual ;
    dcterms:date "2026"^^xsd:gYear ;
    dcterms:identifier "QR-FOT-2026-053-14" ;
    dcterms:source qr:FuenteInventario180 ;
    qr:Alto_px 720 ;
    qr:Ancho_px 1600 ;
    qr:anioOriginalEnInventario "2026"@es ;
    qr:anioRegistro "2026"^^xsd:gYear ;
    qr:condicionDocumental "Fotografía + testimonio directo de participante"@es ;
    qr:contextoRelatado "Después de la llegada desde Tayankani a Ocongate, las agrupaciones permanecen en la cancha hasta la noche; regresan en camión a Paucartambo, adonde llegan de madrugada y descansan. Por la mañana celebran Corpus Christi en las calles. Según el participante, las danzas retornadas intervienen y también escolares de localidades próximas, incluidos niños vestidos como ukumaris. Para su secuencia como integrante de Nación Paucartambo este momento cierra Qoyllur Rit’i; no se generaliza a todas las naciones."@es ;
    qr:descripcionVisual "En una plaza o calle ancha, un grupo porta una estructura pequeña decorada; detrás hay público, banderas y participantes con vestimenta festiva."@es ;
    qr:estadoValidacion "Inspección visual inicial; año y pueblo confirmados por usuario; detalle cronológico y personas no identificados"@es ;
    qr:fechaEnvioNoCaptura "2026-11-08"@es ;
    qr:formaParteDeLote qr:Lote053_2026 ;
    qr:fuenteIdentificacion "El participante identifica expresamente el evento como Corpus Christi de Paucartambo (2026); descripción adicional del regreso desde Ocongate y presencia de escolares."@es ;
    qr:hashSHA256 "0dbe4765b8ed71b8cadf76a929b87958993c50d3cf7c0acb8189b35f151cb062"@es ;
    qr:identificadorAnotacion "QR-AN-053"@es ;
    qr:incertidumbre "La identificación de la celebración y de Paucartambo procede del testimonio del participante. No inferir escuelas, identidad, edad exacta, filiación a una danza ni parentesco desde la imagen; no inferir el orden cronológico por el orden del archivo."@es ;
    qr:lugarContextualTexto "Paucartambo (Cusco, Perú), por testimonio directo del participante"@es ;
    qr:nivelAcceso "Acceso restringido a revisión y permiso; menores/experiencia personal pueden estar presentes"@es,
        "Restringido: imágenes de asistentes, entre ellos menores según testimonio; revisión de permisos pendiente"@es ;
    qr:nombreArchivoOriginal "WhatsApp Image 2026-11-08 at 8.54.55 PM (3).jpeg"@es ;
    qr:nombreConjunto "Corpus Christi de Paucartambo — cierre del recorrido de Nación Paucartambo (2026)"@es ;
    qr:nombreZIPFuente "WhatsApp Unknown 2026-11-08 at 9.01.41 PM.zip"@es ;
    qr:permisoDifusion "No autorizado explícitamente; verificar consentimiento y resguardo de menores antes de difundir"@es ;
    qr:permisoIA "No determinado"@es ;
