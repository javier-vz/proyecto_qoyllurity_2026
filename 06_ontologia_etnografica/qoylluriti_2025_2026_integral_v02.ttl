qr:BanderasNaciones a qr:ObjetoDocumentado ;
    rdfs:label "Banderas de las naciones"@es ;
    rdfs:comment "Numerosas banderas visibles durante descenso, concentraciones y marchas; no inferir nación concreta por imagen"@es .

qr:BofedalSantuario a qr:LugarReferencia ;
    rdfs:label "Bofedal del sector de acampada"@es ;
    rdfs:comment "Referencia contextual en el Santuario; variación de humedad por temporada no determinada"@es .

qr:Caporal a qr:RolParticipante ;
    rdfs:label "Caporal"@es ;
    rdfs:comment "Rol de coordinación ritual/participación; sin identificar personas concretas"@es,
        "Rol mencionado en las actividades; no asocia una persona o jerarquía no documentada"@es .

qr:CargaLeniaMorocos a qr:ObjetoDocumentado ;
    rdfs:label "Leña transportada por morocos"@es ;
    rdfs:comment "Material de apoyo colectivo descrito en camino Mahuayani–Santuario; no afirmar carga universal"@es .

qr:CarpapampaPaucartambo a qr:LugarReferencia ;
    rdfs:label "Carpapampa, Paucartambo"@es ;
    rdfs:comment "Barrio donde el participante sitúa el ensayo general; sin coordenadas"@es .

qr:EncuentroJuegosWataskama a qr:ActividadDocumentada ;
    rdfs:label "Encuentros y juegos en Wataskama"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    qr:descripcionNarrativa "Las agrupaciones se encuentran en lados opuestos del riachuelo, cruzan corriendo y realizan bromas; registro testimonial sin fotos."@es ;
    qr:enEtapaNarrativa qr:Etapa_E09_Wataskama ;
    qr:estadoValidacion "testimonio_directo_sin_foto" ;
    qr:instanciaDePractica qr:PracticaJuegosWataskama ;
    qr:ocurreEn qr:Wataskama ;
    qr:participaColectivo qr:ChunchusPaucartambo,
        qr:QollasPaucartambo,
        qr:UkumarisPaucartambo ;
    qr:tieneEvidencia qr:TestimonioWataskama .

qr:EncuentroWataskamaDocumentado a qr:ActividadDocumentada ;
    rdfs:label "Encuentro y juegos en Wataskama"@es ;
    rdfs:comment "Testimonio de carreras, cruces del riachuelo, saludos y bromas. No hay fotografía aportada y no se asigna año sin confirmación."@es ;
    qr:codigoAnotacion "Sin fotografía; testimonio directo" ;
    qr:descripcionNarrativa "En un valle con riachuelo, danzas de Nación Paucartambo se encuentran, corren por turnos y se hacen bromas. Falta fotografía propia; el testimonio mantiene su valor documental."@es ;
    qr:enEtapaNarrativa qr:Etapa_E09_Wataskama ;
    qr:estadoValidacion "testimonio_sin_fotografia" ;
    qr:instanciaDePractica qr:PracticaEncuentroWataskama ;
    qr:ocurreEn qr:Wataskama ;
    qr:participaColectivo qr:ChunchusPaucartambo,
        qr:QollasPaucartambo,
        qr:UkumarisPaucartambo ;
    qr:tieneEvidencia qr:TestimonioWataskama ;
    qr:tienePreguntaPendiente qr:Q20_FotografiasFaltantes .

qr:EnsayoGeneralPaucartambo a qr:ActividadDocumentada ;
    rdfs:label "Ensayo general en Paucartambo"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    qr:descripcionNarrativa "El sábado antes de la peregrinación, ensayo general en la losa deportiva Huáscar del barrio Carpapampa. No se presupone participación de todas las danzas del pueblo."@es ;
    qr:enEtapaNarrativa qr:Etapa_E01_Preparacion ;
    qr:estadoValidacion "testimonio_participante" ;
    qr:instanciaDePractica qr:PracticaEnsayoGeneral ;
    qr:ocurreEn qr:LosaHuascar ;
    qr:tienePreguntaPendiente qr:Q13_InicioFiesta2025_2026 .

qr:EsperaCanchaOcongateDocumentada a qr:ActividadDocumentada ;
    rdfs:label "Espera en cancha de Ocongate hasta la noche"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    qr:descripcionNarrativa "Participantes permanecen en cancha hasta la noche antes de viajar en camión; testimonio, sin fotografía de espera nocturna."@es ;
    qr:enEtapaNarrativa qr:Etapa_E15_Ocongate ;
    qr:estadoValidacion "testimonio_directo" ;
    qr:instanciaDePractica qr:PracticaEsperaCancha ;
    qr:ocurreEn qr:CanchaOcongate ;
    qr:relacionadaConActividad qr:EncuentroCanchaOcongateDocumentado ;
    qr:sigueEnSecuenciaA qr:EncuentroCanchaOcongateDocumentado .

qr:FuenteGPS2026 a qr:DocumentoFuente ;
    rdfs:label "Doce trazas GPX de 2026"@es ;
    qr:descripcionNarrativa "Los tramos conservados del núcleo RDF original son trazas; proximidad a waypoints es aproximada, no presencia ritual demostrada."@es .

qr:IniciacionMorocosColqueDocumentada a qr:ActividadDocumentada ;
    rdfs:label "Iniciación de morocos en Colque Punku"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    qr:descripcionNarrativa "Según testimonio, novatos se arrodillan, reciben tres golpes rituales con sorriago de caporal y un abrazo; confirmar variabilidad y años, no derivar de fotos."@es ;
    qr:enEtapaNarrativa qr:Etapa_E06_ColquePunku ;
    qr:estadoValidacion "testimonio_requiere_contexto" ;
    qr:instanciaDePractica qr:PracticaIniciacionColque ;
    qr:involucraObjeto qr:Sorriago ;
    qr:ocurreEn qr:GrutaColquePunku ;
    qr:participaColectivo qr:UkumarisPaucartambo ;
    qr:tienePreguntaPendiente qr:Q11_MoroscosColque .

qr:LaderaYanaqancha a qr:LugarReferencia ;
    rdfs:label "Ladera del cerro en Yanaqancha"@es ;
    rdfs:comment "Actividad documentada con fotografía de participantes en ladera; nombre de danza pendiente"@es .

