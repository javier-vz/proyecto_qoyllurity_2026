qr:Medio_QR_FOT_ANO_PEND_052_01 a qr:RegistroAudiovisual ;
    dcterms:identifier "QR-FOT-ANO-PEND-052-01" ;
    dcterms:source qr:FuenteInventario180 ;
    qr:Alto_px 899 ;
    qr:Ancho_px 1599 ;
    qr:condicionDocumental "Fotografía y testimonio directo del participante"@es ;
    qr:contextoRelatado "Después de recorrer a pie el tramo desde Tayankani, las agrupaciones llegan a Ocongate; según el participante, habitantes del pueblo las reciben con alegría, en ocasiones ofreciéndoles chicha; posteriormente se reúnen en una cancha con graderías llenas de espectadores. El tipo específico de evento no está identificado."@es ;
    qr:descripcionVisual "En primer plano, personas sentadas sobre un área de césped, algunas comiendo; al fondo, grupos numerosos reunidos en el campo con banderas y vegetación en las laderas."@es ;
    qr:estadoValidacion "Inspección visual inicial; año de captura y lugares puntuales pendientes de confirmación"@es ;
    qr:fechaEnvioNoCaptura "2026-11-08"@es ;
    qr:formaParteDeLote qr:Lote052_AnioPendiente ;
    qr:fuenteIdentificacion "Relato directo del usuario, acompañado de registro fotográfico"@es ;
    qr:hashSHA256 "45df0b307dd677247c8028d3bae8dca4bbd4623667a2e3c58aadf565ed2cecd2"@es ;
    qr:identificadorAnotacion "QR-AN-052"@es ;
    qr:incertidumbre "El año de captura no está acreditado por los metadatos. El relato de chicha y bienvenida viene de testimonio directo; no atribuirlo a personas concretas ni afirmar que se observa la entrega en estas imágenes. No identificar formalmente el evento en la cancha. El orden de los archivos no demuestra una cronología."@es ;
    qr:lugarContextualTexto "Trayecto Tayankani–Ocongate / Ocongate, por testimonio del participante; ubicación exacta de la toma pendiente"@es ;
    qr:nivelAcceso "Interno / por confirmar permisos de difusión"@es ;
    qr:nombreArchivoOriginal "WhatsApp Image 2026-11-08 at 8.54.19 PM.jpeg"@es ;
    qr:nombreConjunto "Camino Tayankani–Ocongate, recibimiento y encuentro en la cancha — año pendiente de confirmación"@es ;
    qr:nombreZIPFuente "WhatsApp Unknown 2026-11-08 at 8.55.55 PM.zip"@es ;
    qr:permisoDifusion "No determinado; no publicar sin autorización"@es ;
    qr:permisoIA "Sin autorización explícita para reutilización externa"@es ;
    qr:relacionConMaterial "Sin EXIF de captura disponible. Fotografías 2 y 3 muestran el recinto deportivo; 5 muestra caminata con banderas; 4 vista de concentración; 1 asistentes en césped."@es ;
