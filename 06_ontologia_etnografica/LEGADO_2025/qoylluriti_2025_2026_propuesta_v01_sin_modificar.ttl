qr26:AscensoColquePunku2026 a qr26:ActividadDocumentada ;
    rdfs:label "Ascenso desde Santuario a Colque Punku (2026)"@es ;
    dcterms:date "2026"^^xsd:gYear ;
    rdfs:comment "Recorrido nocturno documentado por GPS 05."@es ;
    qr26:formaParteDeFestividad qr26:QoyllurRiti2026 ;
    qr26:instanciaDePractica qr26:PracticaAscensoGlaciar ;
    qr26:ocurreEn qr26:ColquePunku ;
    qr26:relacionadoConTramoGPS qr26:Tramo05 .

qr26:BautizoMorocoTayankani2025 a qr26:ActividadDocumentada ;
    rdfs:label "Bautizo de moroco al final del Inti Alabado (2025)"@es ;
    dcterms:date "2025"^^xsd:gYear ;
    rdfs:comment "Experiencia personal del investigador-participante; no identificar a la persona ni adjudicar gestos específicos desde la foto; la gruta exacta no está conciliada."@es ;
    qr26:codigoAnotacion "QR-AN-051" ;
    qr26:formaParteDeFestividad qr26:QoyllurRiti2025 ;
    qr26:incluyeRol qr26:Moroco ;
    qr26:instanciaDePractica qr26:PracticaBautizoMoroco ;
    qr26:nivelAcceso "restringido"@es ;
    qr26:ocurreEn qr26:Tayankani ;
    qr26:participaColectivo qr26:UkumarisPaucartambo ;
    qr26:sigueEnSecuenciaA qr26:IntiAlabado2025 ;
    qr26:tieneEvidencia qr26:Lote051_2025,
        qr26:Testimonio051 .

qr26:CaminoMahuayaniSantuario2026 a qr26:ActividadDocumentada ;
