@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qr26: <urn:qoylluriti:registro2026:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qr26:Grupo a owl:Class ;
    rdfs:label "Grupo o colectivo"@es ;
    rdfs:comment "Denominación documentada de un colectivo, sin inferir membresía individual"@es .

qr26:LugarReferencia a owl:Class ;
    rdfs:label "Lugar de referencia"@es ;
    rdfs:comment "Topónimo o referencia de campo, no delimitación geográfica oficial"@es .

qr26:Recorrido a owl:Class ;
    rdfs:label "Recorrido documentado"@es ;
    rdfs:comment "Conjunto de tramos registrados en la campaña 2026; no equivale a ruta oficial o normativa"@es .

qr26:Tramo a owl:Class ;
    rdfs:label "Tramo de trayectoria GPS"@es ;
    rdfs:comment "Una traza temporal registrada por un dispositivo"@es .

qr26:NacionPaucartambo a qr26:Grupo ;
    rdfs:label "Nación Paucartambo"@es ;
    dcterms:source "UNESCO, expediente 00567: nación identificada por denominación de origen; la relación no implica pertenencia de participantes fotografiados ni de todas las trazas GPS"@es ;
    qr26:vinculadoALugar qr26:Paucartambo .

qr26:RecorridoRegistrado2026 a qr26:Recorrido ;
    rdfs:label "Recorrido documentado de Qoyllur Rit’i, 2026"@es ;
    dcterms:date "2026"^^xsd:gYear ;
    rdfs:comment "Agrupación documental de 12 archivos GPX con tramos a pie y en vehículo. No representa todas las rutas de todas las naciones ni un itinerario oficial."@es ;
    qr26:contieneTramo qr26:Tramo01,
        qr26:Tramo02,
        qr26:Tramo03,
        qr26:Tramo04,
        qr26:Tramo05,
        qr26:Tramo06,
        qr26:Tramo07,
        qr26:Tramo08,
        qr26:Tramo09,
        qr26:Tramo10,
        qr26:Tramo11,
        qr26:Tramo12 .

qr26:asociadoAGrupo a owl:ObjectProperty ;
    rdfs:label "asociado a grupo"@es ;
    rdfs:comment "Relación reservada para adscripción de tramos o recorridos a colectivos solo con evidencia específica"@es .

qr26:contieneTramo a owl:ObjectProperty ;
    rdfs:label "contiene tramo"@es ;
    rdfs:comment "Vincula el registro global con las trazas que lo componen"@es .

qr26:mencionaLugar a owl:ObjectProperty ;
    rdfs:label "menciona lugar"@es ;
    rdfs:comment "El topónimo figura en el nombre original del archivo GPX; no es una comprobación espacial"@es .

qr26:proximoAReferencia a owl:ObjectProperty ;
    rdfs:label "próximo a referencia"@es ;
    rdfs:comment "La polilínea GPX se aproximó a menos de 200 metros de un waypoint de campo guardado; ver CSV de evidencia"@es .

qr26:vinculadoALugar a owl:ObjectProperty ;
    rdfs:label "vinculado a lugar"@es ;
    rdfs:comment "Relación documental entre entidad de grupo y topónimo, atribuida a fuente explícita"@es .

