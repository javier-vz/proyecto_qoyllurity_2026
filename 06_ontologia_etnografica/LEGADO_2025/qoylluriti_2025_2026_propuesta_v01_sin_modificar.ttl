    dcterms:source "Testimonio directo de integrante de los ukumaris de Nación Paucartambo, aportado durante reconstrucción etnográfica (noviembre de 2026); archivo de anotaciones relacionado."@es ;
    qr26:nivelAcceso "revisión editorial"@es .

qr26:Testimonio052 a qr26:Testimonio ;
    rdfs:label "Trayecto Tayankani-Ocongate, recepción con chicha, encuentro en la cancha y retorno nocturno; año del lote de Ocongate sin confirmar."@es ;
    dcterms:source "Testimonio directo de integrante de los ukumaris de Nación Paucartambo, aportado durante reconstrucción etnográfica (noviembre de 2026); archivo de anotaciones relacionado."@es ;
    qr26:nivelAcceso "revisión editorial"@es .

qr26:Yanaqancha skos:altLabel "Yanacancha"@es .

qr26:UkumarisVariasNaciones a qr26:Grupo ;
    rdfs:label "Ukumaris de distintas naciones"@es ;
    rdfs:comment "Agrupación descriptiva genérica; no enumera todas las naciones participantes ni sus miembros."@es .

qr26:UkumarisPaucartambo a qr26:AgrupacionDanza ;
    rdfs:label "Ukumaris de Nación Paucartambo"@es ;
    rdfs:comment "Agrupación del testimonio participante, sin registrar identidades personales."@es ;
    qr26:perteneceANacion qr26:NacionPaucartambo .

qr26:QoyllurRiti2026 a qr26:Festividad ;
    rdfs:label "Qoyllur Rit’i 2026"@es ;
    dcterms:date "2026"^^xsd:gYear .

qr26:QoyllurRiti2025 a qr26:Festividad ;
    rdfs:label "Qoyllur Rit’i 2025"@es ;
    dcterms:date "2025"^^xsd:gYear .

qr26:ConjuntoAudiovisual a owl:Class ;
    rdfs:label "Conjunto de medios audiovisuales"@es ;
    rdfs:comment "Referencia al lote y a los identificadores del inventario, sin almacenar fotografías dentro del TTL"@es ;
    rdfs:subClassOf qr26:Evidencia .

qr26:Testimonio a owl:Class ;
    rdfs:label "Testimonio de participante"@es ;
    rdfs:comment "Fuente de campo; puede respaldar actividades sin medio visual"@es ;
    rdfs:subClassOf qr26:Evidencia .

qr26:PracticaCultural a owl:Class ;
    rdfs:label "Práctica cultural"@es ;
    rdfs:comment "Concepto que puede manifestarse en diferentes años o lugares"@es .

qr26:ActividadDocumentada a owl:Class ;
    rdfs:label "Actividad o episodio documentado"@es ;
    rdfs:comment "Ocurrencia situada y documentada; puede existir sin fotografías"@es .

