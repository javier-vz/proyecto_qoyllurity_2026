qr26:instanciaDePractica a owl:ObjectProperty ;
    rdfs:label "es instancia de una práctica"@es ;
    rdfs:comment "Vincula episodio con una práctica general, sin fusionar eventos de diferentes años"@es .

qr26:involucraObjeto a owl:ObjectProperty ;
    rdfs:label "involucra objeto"@es ;
    rdfs:comment "Objeto mencionado en episodio; no deduce uso ritual del aspecto del objeto"@es .

qr26:nivelAcceso a owl:DatatypeProperty ;
    rdfs:label "nivel de acceso"@es .

qr26:numeroRecursos a owl:DatatypeProperty ;
    rdfs:label "número de recursos audiovisuales"@es .

qr26:ocurreEn a owl:ObjectProperty ;
    rdfs:label "ocurre en"@es ;
    rdfs:comment "Asociación de episodio con lugar relatado; no implica punto GPS exacto"@es .

qr26:participaColectivo a owl:ObjectProperty ;
    rdfs:label "participa el colectivo"@es ;
    rdfs:comment "Solo se afirma cuando el testimonio identifica el colectivo"@es .

qr26:perteneceANacion a owl:ObjectProperty ;
    rdfs:label "pertenece a nación"@es ;
    rdfs:comment "Relación explícita de una agrupación de danza con una nación; no asigna miembros individuales"@es .

qr26:referenciaTTLAnterior a owl:ObjectProperty ;
    rdfs:label "referencia al TTL anterior"@es ;
    rdfs:comment "Referencia de conciliación editorial; no significa equivalencia ontológica comprobada"@es .

qr26:relacionadaConActividad a owl:ObjectProperty ;
    rdfs:label "relacionada con actividad"@es ;
    rdfs:comment "Vincula episodios culturalmente relacionados sin afirmar anterioridad estricta"@es .

qr26:relacionadoConTramoGPS a owl:ObjectProperty ;
    rdfs:label "relacionado con tramo GPS"@es ;
    rdfs:comment "Correspondencia contextual sin garantía de lugar exacto de actividad"@es .

qr26:sigueEnSecuenciaA a owl:ObjectProperty ;
    rdfs:label "sigue en la secuencia a"@es ;
    rdfs:comment "Orden relativo aportado por testimonio; no exige contigüidad espacial ni hora exacta"@es .

qr26:tieneEvidencia a owl:ObjectProperty ;
    rdfs:label "tiene evidencia"@es ;
    rdfs:comment "Testimonio, conjunto audiovisual u otra fuente que sustenta una actividad"@es .

