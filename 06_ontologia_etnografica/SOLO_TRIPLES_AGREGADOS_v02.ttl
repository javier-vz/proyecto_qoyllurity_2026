    ns1:anioOriginalEnInventario "2025"@es ;
    ns1:anioRegistro "2025"^^xsd:gYear ;
    ns1:condicionDocumental "Imagen o video de 2025 + testimonio directo de participante"@es ;
    ns1:contextoRelatado "Según el usuario, al llegar del descenso se reúnen ukumaris de diversas naciones; la cruz previamente llevada a la gruta de Colque Punku se baja y se turna su transporte entre naciones. El video corresponde al turno de Nación Paucartambo. El relevo puede ser lúdico y también físicamente áspero o disputado."@es ;
    ns1:descripcionVisual "Grupo de participantes alineados junto a banderas rojas y negras sobre ladera pedregosa."@es ;
    ns1:estadoValidacion "Año y sector general confirmados por usuario; atribución del turno de la cruz por testimonio"@es ;
    ns1:fechaEnvioNoCaptura "2026-11-08"@es ;
    ns1:formaParteDeLote ns1:Lote046_2025 ;
    ns1:fuenteIdentificacion "Año y sector relatados por el usuario; la imagen muestra concentración y banderas"@es ;
    ns1:hashSHA256 "8edbc1206c3db79b1de9b49779a8e9183ddaae97599114f897fbb4cee4c806fa"@es ;
    ns1:identificadorAnotacion "QR-AN-046"@es ;
    ns1:incertidumbre "La identidad de las naciones y los turnos de la cruz no se deducen solo de las imágenes; se registran como testimonio del participante. No inferir violencia o reglas formales desde movimientos de multitud."@es ;
    ns1:lugarContextualTexto "Sector de llegada del descenso de Colque Punku, próximo al Santuario (según el usuario)"@es ;
    ns1:nivelAcceso "solo_equipo hasta revisión de imágenes, permisos y contexto comunitario"@es ;
    ns1:nombreArchivoOriginal "WhatsApp Image 2026-11-08 at 8.09.14 PM.jpeg"@es ;
    ns1:nombreConjunto "14_descenso_cruz_reunion_naciones_2025"@es ;
    ns1:nombreZIPFuente "WhatsApp Unknown 2026-11-08 at 8.17.16 PM.zip"@es ;
    ns1:permisoDifusion "Pendiente de autorización"@es ;
    ns1:permisoIA "No evaluado: no usar para entrenamiento sin autorización"@es ;
    ns1:relacionConMaterial "El nombre WhatsApp 2026-11-08 indica envío, no captura. No atribuir automáticamente pertenencia nacional a rostros/vestimentas; la asignación Nación Paucartambo proviene del testimonio. Cruz y turnos requieren localización en el video para anotación temporal fina."@es ;
    ns1:rutaMedioArchivo "Conservar el ZIP original como archivo interno; no se redistribuye en este CSV"@es ;
    ns1:tipoMedio "Fotografía"@es ;
