ns1:Medio_QR_FOT_ANO_PEND_052_01 a ns1:RegistroAudiovisual ;
    dcterms:identifier "QR-FOT-ANO-PEND-052-01" ;
    dcterms:source ns1:FuenteInventario180 ;
    ns1:Alto_px 899 ;
    ns1:Ancho_px 1599 ;
    ns1:condicionDocumental "Fotografía y testimonio directo del participante"@es ;
    ns1:contextoRelatado "Después de recorrer a pie el tramo desde Tayankani, las agrupaciones llegan a Ocongate; según el participante, habitantes del pueblo las reciben con alegría, en ocasiones ofreciéndoles chicha; posteriormente se reúnen en una cancha con graderías llenas de espectadores. El tipo específico de evento no está identificado."@es ;
    ns1:descripcionVisual "En primer plano, personas sentadas sobre un área de césped, algunas comiendo; al fondo, grupos numerosos reunidos en el campo con banderas y vegetación en las laderas."@es ;
    ns1:estadoValidacion "Inspección visual inicial; año de captura y lugares puntuales pendientes de confirmación"@es ;
    ns1:fechaEnvioNoCaptura "2026-11-08"@es ;
    ns1:formaParteDeLote ns1:Lote052_AnioPendiente ;
    ns1:fuenteIdentificacion "Relato directo del usuario, acompañado de registro fotográfico"@es ;
    ns1:hashSHA256 "45df0b307dd677247c8028d3bae8dca4bbd4623667a2e3c58aadf565ed2cecd2"@es ;
    ns1:identificadorAnotacion "QR-AN-052"@es ;
    ns1:incertidumbre "El año de captura no está acreditado por los metadatos. El relato de chicha y bienvenida viene de testimonio directo; no atribuirlo a personas concretas ni afirmar que se observa la entrega en estas imágenes. No identificar formalmente el evento en la cancha. El orden de los archivos no demuestra una cronología."@es ;
    ns1:lugarContextualTexto "Trayecto Tayankani–Ocongate / Ocongate, por testimonio del participante; ubicación exacta de la toma pendiente"@es ;
    ns1:nivelAcceso "Interno / por confirmar permisos de difusión"@es ;
    ns1:nombreArchivoOriginal "WhatsApp Image 2026-11-08 at 8.54.19 PM.jpeg"@es ;
    ns1:nombreConjunto "Camino Tayankani–Ocongate, recibimiento y encuentro en la cancha — año pendiente de confirmación"@es ;
    ns1:nombreZIPFuente "WhatsApp Unknown 2026-11-08 at 8.55.55 PM.zip"@es ;
    ns1:permisoDifusion "No determinado; no publicar sin autorización"@es ;
