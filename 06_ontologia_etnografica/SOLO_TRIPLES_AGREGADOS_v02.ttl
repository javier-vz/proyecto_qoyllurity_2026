ns1:Medio_QR_FOT_2025_046_01 a ns1:RegistroAudiovisual ;
    dcterms:date "2025"^^xsd:gYear ;
    dcterms:identifier "QR-FOT-2025-046-01" ;
    dcterms:source ns1:FuenteInventario180 ;
