ns1:Medio_QR_FOT_2025_044_01 a ns1:RegistroAudiovisual ;
    dcterms:date "2025"^^xsd:gYear ;
    dcterms:identifier "QR-FOT-2025-044-01" ;
    dcterms:source ns1:FuenteInventario180 ;
    ns1:Alto_px 720 ;
    ns1:Ancho_px 1600 ;
    ns1:anioOriginalEnInventario "2025"@es ;
    ns1:anioRegistro "2025"^^xsd:gYear ;
    ns1:condicionDocumental "Imagen de 2025 + testimonio situado del investigador-participante"@es ;
    ns1:contextoRelatado "Según experiencia del usuario, 2025 presentó bastante nieve frente a 2026; nieve vivida como una suerte de bendición. Durante el descenso los peregrinos avanzaban en fila, coincidiendo con ukumaris de otras naciones; avanzó el amanecer y el suelo siguió congelado."@es ;
    ns1:descripcionVisual "Peregrinos en fila sobre una senda de montaña con rocas, laderas y nieve dispersa."@es ;
    ns1:estadoValidacion "Año y tramo general confirmados por usuario; localización individual y hora pendientes"@es ;
    ns1:fechaEnvioNoCaptura "2026-11-08"@es ;
    ns1:formaParteDeLote ns1:Lote044_2025 ;
    ns1:fuenteIdentificacion "El usuario identifica el conjunto como bajada de 2025; no inferir fecha de captura del nombre WhatsApp."@es ;
    ns1:hashSHA256 "9a01f109373320c96e74e0deacd03d1de9e2c43edd22da4102f1288da1e55138"@es ;
    ns1:identificadorAnotacion "QR-AN-044"@es ;
    ns1:incertidumbre "La nieve visible no cuantifica diferencias interanuales ni acredita por sí misma una tendencia climática. No se atribuyen adscripciones nacionales individuales a personas visibles."@es ;
    ns1:lugarContextualTexto "Descenso desde Colque Punku hacia el Santuario (según usuario)"@es ;
    ns1:nivelAcceso "solo_equipo hasta revisión de imágenes y consentimiento"@es ;
    ns1:nombreArchivoOriginal "WhatsApp Image 2026-11-08 at 7.51.48 PM.jpeg"@es ;
    ns1:nombreConjunto "12_descenso_colque_punku_2025"@es ;
    ns1:nombreZIPFuente "WhatsApp Unknown 2026-11-08 at 7.56.32 PM.zip"@es ;
    ns1:permisoDifusion "Pendiente de autorización"@es ;
    ns1:permisoIA "No evaluado: no usar para entrenamiento automáticamente"@es ;
    ns1:relacionConMaterial "Comparación 2025–2026 testimonial y visual cualitativa; no equivale a medir cobertura nival ni hielo o clima a largo plazo."@es ;
    ns1:rutaMedioArchivo "Conservar ZIP fuente como archivo privado, sin publicar automáticamente"@es ;
    ns1:tipoMedio "Fotografía"@es ;
    ns1:vinculadoALugarContextual ns1:ColquePunku .

