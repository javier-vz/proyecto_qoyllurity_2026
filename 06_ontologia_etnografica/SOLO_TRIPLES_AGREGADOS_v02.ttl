ns1:LegadoEntidad_TrajeUkumari a ns1:ReferenciaLegado ;
    rdfs:label "Traje de Ukumari"@es ;
    dcterms:identifier "TrajeUkumari" ;
    dcterms:source "qoyllurity(6)(1).ttl" ;
    ns1:condicionDocumental "Tipos en TTL 2025: Vestimenta"@es ;
    ns1:descripcionNarrativa "Vestimenta ceremonial completa del ukuku que incluye: pellón (traje principal de lana), huaqollo (careta tejida de lana que cubre el rostro), umak'ara (pedazo de cuero en la cabeza), sorriago (látigo ceremonial de cuero trenzado), cruz de cobre portada en el pecho, silbato para anunciarse, puyka (caña para hacer ruido que imita a los osos), guantes y camisa blanca. El conjunto representa al oso andino y sus funciones rituales."@es ;
    ns1:estadoMigracion "referencia_historica_no_conciliada" .

