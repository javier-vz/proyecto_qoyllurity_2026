ns1:BanderasNaciones a ns1:ObjetoDocumentado ;
    rdfs:label "Banderas de las naciones"@es ;
    rdfs:comment "Numerosas banderas visibles durante descenso, concentraciones y marchas; no inferir nación concreta por imagen"@es .

ns1:BofedalSantuario a ns1:LugarReferencia ;
    rdfs:label "Bofedal del sector de acampada"@es ;
    rdfs:comment "Referencia contextual en el Santuario; variación de humedad por temporada no determinada"@es .

ns1:Caporal rdfs:comment "Rol de coordinación ritual/participación; sin identificar personas concretas"@es .

ns1:CargaLeniaMorocos a ns1:ObjetoDocumentado ;
    rdfs:label "Leña transportada por morocos"@es ;
    rdfs:comment "Material de apoyo colectivo descrito en camino Mahuayani–Santuario; no afirmar carga universal"@es .

ns1:CarpapampaPaucartambo a ns1:LugarReferencia ;
    rdfs:label "Carpapampa, Paucartambo"@es ;
    rdfs:comment "Barrio donde el participante sitúa el ensayo general; sin coordenadas"@es .

ns1:CruzColquePunku rdfs:comment "Cruz subida a gruta el día anterior y bajada; el testimonio atribuye su carga por turnos a diferentes naciones"@es .

ns1:EncuentroJuegosWataskama a ns1:ActividadDocumentada ;
    rdfs:label "Encuentros y juegos en Wataskama"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    ns1:descripcionNarrativa "Las agrupaciones se encuentran en lados opuestos del riachuelo, cruzan corriendo y realizan bromas; registro testimonial sin fotos."@es ;
    ns1:enEtapaNarrativa ns1:Etapa_E09_Wataskama ;
    ns1:estadoValidacion "testimonio_directo_sin_foto" ;
    ns1:instanciaDePractica ns1:PracticaJuegosWataskama ;
    ns1:ocurreEn ns1:Wataskama ;
    ns1:participaColectivo ns1:ChunchusPaucartambo,
        ns1:QollasPaucartambo,
        ns1:UkumarisPaucartambo ;
    ns1:tieneEvidencia ns1:TestimonioWataskama .

ns1:EncuentroWataskamaDocumentado ns1:descripcionNarrativa "En un valle con riachuelo, danzas de Nación Paucartambo se encuentran, corren por turnos y se hacen bromas. Falta fotografía propia; el testimonio mantiene su valor documental."@es ;
    ns1:enEtapaNarrativa ns1:Etapa_E09_Wataskama ;
    ns1:estadoValidacion "testimonio_sin_fotografia" ;
    ns1:tienePreguntaPendiente ns1:Q20_FotografiasFaltantes .

ns1:EnsayoGeneralPaucartambo a ns1:ActividadDocumentada ;
    rdfs:label "Ensayo general en Paucartambo"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    ns1:descripcionNarrativa "El sábado antes de la peregrinación, ensayo general en la losa deportiva Huáscar del barrio Carpapampa. No se presupone participación de todas las danzas del pueblo."@es ;
    ns1:enEtapaNarrativa ns1:Etapa_E01_Preparacion ;
    ns1:estadoValidacion "testimonio_participante" ;
    ns1:instanciaDePractica ns1:PracticaEnsayoGeneral ;
    ns1:ocurreEn ns1:LosaHuascar ;
    ns1:tienePreguntaPendiente ns1:Q13_InicioFiesta2025_2026 .

ns1:EsperaCanchaOcongateDocumentada a ns1:ActividadDocumentada ;
    rdfs:label "Espera en cancha de Ocongate hasta la noche"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    ns1:descripcionNarrativa "Participantes permanecen en cancha hasta la noche antes de viajar en camión; testimonio, sin fotografía de espera nocturna."@es ;
    ns1:enEtapaNarrativa ns1:Etapa_E15_Ocongate ;
    ns1:estadoValidacion "testimonio_directo" ;
    ns1:instanciaDePractica ns1:PracticaEsperaCancha ;
    ns1:ocurreEn ns1:CanchaOcongate ;
    ns1:relacionadaConActividad ns1:EncuentroCanchaOcongateDocumentado ;
    ns1:sigueEnSecuenciaA ns1:EncuentroCanchaOcongateDocumentado .

ns1:FuenteGPS2026 a ns1:DocumentoFuente ;
    rdfs:label "Doce trazas GPX de 2026"@es ;
    ns1:descripcionNarrativa "Los tramos conservados del núcleo RDF original son trazas; proximidad a waypoints es aproximada, no presencia ritual demostrada."@es .

ns1:IniciacionMorocosColqueDocumentada a ns1:ActividadDocumentada ;
    rdfs:label "Iniciación de morocos en Colque Punku"@es ;
    dcterms:source "Testimonio de investigador-participante y/o conjunto audiovisual contextual de 2025–2026"@es ;
    ns1:descripcionNarrativa "Según testimonio, novatos se arrodillan, reciben tres golpes rituales con sorriago de caporal y un abrazo; confirmar variabilidad y años, no derivar de fotos."@es ;
    ns1:enEtapaNarrativa ns1:Etapa_E06_ColquePunku ;
    ns1:estadoValidacion "testimonio_requiere_contexto" ;
    ns1:instanciaDePractica ns1:PracticaIniciacionColque ;
    ns1:involucraObjeto ns1:Sorriago ;
    ns1:ocurreEn ns1:GrutaColquePunku ;
    ns1:participaColectivo ns1:UkumarisPaucartambo ;
    ns1:tienePreguntaPendiente ns1:Q11_MoroscosColque .

ns1:LaderaYanaqancha a ns1:LugarReferencia ;
    rdfs:label "Ladera del cerro en Yanaqancha"@es ;
    rdfs:comment "Actividad documentada con fotografía de participantes en ladera; nombre de danza pendiente"@es .

