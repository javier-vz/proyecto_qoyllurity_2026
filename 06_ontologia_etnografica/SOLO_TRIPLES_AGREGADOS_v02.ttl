ns1:Medio_QR_FOT_2026_053_01 a ns1:RegistroAudiovisual ;
    dcterms:date "2026"^^xsd:gYear ;
    dcterms:identifier "QR-FOT-2026-053-01" ;
    dcterms:source ns1:FuenteInventario180 ;
    ns1:Alto_px 720 ;
    ns1:Ancho_px 1600 ;
    ns1:anioOriginalEnInventario "2026"@es ;
    ns1:anioRegistro "2026"^^xsd:gYear ;
    ns1:condicionDocumental "Fotografía + testimonio directo de participante"@es ;
    ns1:contextoRelatado "Después de la llegada desde Tayankani a Ocongate, las agrupaciones permanecen en la cancha hasta la noche; regresan en camión a Paucartambo, adonde llegan de madrugada y descansan. Por la mañana celebran Corpus Christi en las calles. Según el participante, las danzas retornadas intervienen y también escolares de localidades próximas, incluidos niños vestidos como ukumaris. Para su secuencia como integrante de Nación Paucartambo este momento cierra Qoyllur Rit’i; no se generaliza a todas las naciones."@es ;
    ns1:descripcionVisual "Fachada de una iglesia y reunión de personas alrededor de andas ornamentadas con imágenes religiosas, flores y textiles."@es ;
    ns1:estadoValidacion "Inspección visual inicial; año y pueblo confirmados por usuario; detalle cronológico y personas no identificados"@es ;
    ns1:fechaEnvioNoCaptura "2026-11-08"@es ;
    ns1:formaParteDeLote ns1:Lote053_2026 ;
    ns1:fuenteIdentificacion "El participante identifica expresamente el evento como Corpus Christi de Paucartambo (2026); descripción adicional del regreso desde Ocongate y presencia de escolares."@es ;
    ns1:hashSHA256 "ea3f44ba64a45a6976207aa089378df826d28cbf12e814f403d3a92bce4585e5"@es ;
    ns1:identificadorAnotacion "QR-AN-053"@es ;
    ns1:incertidumbre "La identificación de la celebración y de Paucartambo procede del testimonio del participante. No inferir escuelas, identidad, edad exacta, filiación a una danza ni parentesco desde la imagen; no inferir el orden cronológico por el orden del archivo."@es ;
    ns1:lugarContextualTexto "Paucartambo (Cusco, Perú), por testimonio directo del participante"@es ;
    ns1:nivelAcceso "Acceso restringido a revisión y permiso; menores/experiencia personal pueden estar presentes"@es,
        "Restringido: imágenes de asistentes, entre ellos menores según testimonio; revisión de permisos pendiente"@es ;
    ns1:nombreArchivoOriginal "WhatsApp Image 2026-11-08 at 8.54.53 PM.jpeg"@es ;
    ns1:nombreConjunto "Corpus Christi de Paucartambo — cierre del recorrido de Nación Paucartambo (2026)"@es ;
    ns1:nombreZIPFuente "WhatsApp Unknown 2026-11-08 at 9.01.41 PM.zip"@es ;
    ns1:permisoDifusion "No autorizado explícitamente; verificar consentimiento y resguardo de menores antes de difundir"@es ;
    ns1:permisoIA "No determinado"@es ;
    ns1:relacionConMaterial "El nombre WhatsApp (2026-11-08) es fecha de envío, NO fecha de la captura. Testimonio de año de celebración: 2026. No confundir la fiesta de Corpus Christi con la peregrinación; documentar vínculo de sucesión desde la experiencia de Nación Paucartambo."@es ;
    ns1:rutaMedioArchivo "WhatsApp Image 2026-11-08 at 8.54.53 PM.jpeg"@es ;
    ns1:tipoMedio "Fotografía"@es ;
    ns1:vinculadoALugarContextual ns1:Paucartambo .

