@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qr: <http://example.org/festividades#> .
@prefix qr26: <urn:qoylluriti:registro2026:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qr:CanchaOcongate a qr:Lugar ;
    rdfs:label "Cancha de Ocongate"@es ;
    qr:ubicadoEn qr:Ocongate ;
    rdfs:comment "Espacio donde se reúnen los grupos al llegar desde Tayankani; hay público en las graderías y la espera continúa hasta la noche."@es .

qr:ChunchusPaucartambo a qr:AgrupacionDanza ;
    rdfs:label "Chunchus de Nación Paucartambo"@es ;
    qr:formaParteDe qr:NacionPaucartambo ;
    qr:participaEn qr:CantoQespiCruz,
        qr:CorpusChristiPaucartambo,
        qr:EncuentroWataskama,
        qr:Lomada,
        qr:PreparacionPaucartambo,
        qr:ProcesionImagenTayankani ;
    qr:recorre qr:RutaLomada ;
    rdfs:comment "Agrupación de Nación Paucartambo que coincide con los ukumaris y Qollas en distintos momentos del camino y en celebraciones."@es .

qr:EscolaresCorpusChristi a qr:Colectivo ;
    rdfs:label "Escolares participantes en Corpus Christi de Paucartambo"@es ;
    qr:participaEn qr:CorpusChristiPaucartambo ;
    rdfs:comment "Escolares de localidades próximas que participan vestidos como diferentes danzas, entre ellas ukumaris. Las observaciones de 2026 incluyen numerosos niños."@es .

qr:GrutaYanaqancha a qr:Lugar ;
    rdfs:label "Gruta de Yanaqancha"@es ;
    qr:ubicadoEn qr:Yanaqancha ;
    rdfs:comment "Sector de gruta por el que transcurre parte de la ruta de la Lomada en las inmediaciones de Yanaqancha."@es .

qr:IglesiaCcatcca a qr:Lugar ;
    rdfs:label "Iglesia de Ccatcca"@es ;
    qr:ubicadoEn qr:Ccatcca ;
    rdfs:comment "Iglesia señalada como lugar de visita durante la parada de la peregrinación."@es .

qr:LosaHuascarCarpapampa a qr:Lugar ;
    rdfs:label "Losa deportiva Huáscar"@es ;
    qr:ubicadoEn qr:Carpapampa ;
    rdfs:comment "Lugar del ensayo general de las danzas antes de la salida de Paucartambo."@es .

qr:Mamawairis a qr:Colectivo ;
    rdfs:label "Mamawairis"@es ;
    qr:participaEn qr:PermanenciaSantuario,
        qr:PreparacionPaucartambo ;
    rdfs:comment "Familiares y acompañantes que sostienen parte de la organización material del recorrido: transporte, comida, bultos y apoyo durante el viaje y la permanencia en los lugares de descanso."@es .

qr:Pachakunapata a qr:Lugar ;
    rdfs:label "P’achakunapata"@es ;
    qr:ubicadoEn qr:SantuarioQoylluriti ;
    rdfs:comment "Hito por el que se pasa durante el ingreso al Santuario."@es .

qr:PlazaCcatcca a qr:Lugar ;
    rdfs:label "Plaza de Ccatcca"@es ;
    qr:ubicadoEn qr:Ccatcca ;
    rdfs:comment "Espacio referido en el registro histórico para el descanso y la comida compartida durante el viaje."@es .

qr:PlazaOcongate a qr:Lugar ;
    rdfs:label "Plaza de Ocongate"@es ;
    qr:ubicadoEn qr:Ocongate ;
    rdfs:comment "Plaza de Ocongate, uno de los espacios del pueblo por los que circulan agrupaciones y peregrinos en su regreso."@es .

qr:PlazaPaucartambo a qr:Lugar ;
    rdfs:label "Plaza de Paucartambo"@es ;
    qr:ubicadoEn qr:Paucartambo ;
    rdfs:comment "Espacio público vinculado a las actividades de preparación y recorridos urbanos."@es .

qr:PoblacionOcongate a qr:Colectivo ;
    rdfs:label "Población de Ocongate"@es ;
    qr:vinculadoALugar qr:Ocongate ;
    rdfs:comment "Personas del pueblo que reciben a los peregrinos en el tramo de retorno desde Tayankani; se relata alegría y ofrecimiento de chicha a los grupos que llegan."@es .

qr:Prioste a qr:Rol ;
    rdfs:label "Prioste"@es ;
    rdfs:comment "Rol asociado a la acogida y organización de una parada del viaje, donde coinciden integrantes de diversas agrupaciones."@es .

qr:QollasPaucartambo a qr:AgrupacionDanza ;
    rdfs:label "Qollas de Nación Paucartambo"@es ;
    qr:formaParteDe qr:NacionPaucartambo ;
    qr:participaEn qr:CantoQespiCruz,
        qr:CorpusChristiPaucartambo,
        qr:EncuentroWataskama,
        qr:Lomada,
        qr:PreparacionPaucartambo,
        qr:ProcesionImagenTayankani ;
    qr:recorre qr:RutaLomada ;
    rdfs:comment "Agrupación de Nación Paucartambo que participa en el recorrido. En el inicio de la Lomada los Qollas suben al encuentro de quienes descienden desde Colque Punku."@es .

qr:Ukumaris a qr:AgrupacionDanza ;
    rdfs:label "Ukumaris / ukukus"@es ;
    qr:participaEn qr:AscensoColquePunku,
        qr:DescensoColquePunku,
        qr:IntiAlabado,
        qr:TrasladoCruzColquePunku ;
    rdfs:comment "Denominación de los danzantes conocidos como ukumaris o ukukus, presentes en diferentes naciones. Entre sus acciones durante la peregrinación se encuentran el ascenso a Colque Punku, las carreras en zigzag del Inti Alabado y el traslado de la cruz entre naciones."@es .

qr:UkumarisPaucartambo a qr:AgrupacionDanza ;
    rdfs:label "Ukumaris de Nación Paucartambo"@es ;
    qr:formaParteDe qr:NacionPaucartambo ;
    qr:incluyeRol qr:Caporal,
        qr:Moroco ;
    qr:participaEn qr:AscensoColquePunku,
        qr:BautizoMorocos,
        qr:CantoQespiCruz,
        qr:CorpusChristiPaucartambo,
        qr:DescensoColquePunku,
        qr:DespedidaMachuCruz,
        qr:DespedidaYanaqocha,
        qr:EncuentroWataskama,
        qr:IntiAlabado,
        qr:Lomada,
        qr:PermanenciaSantuario,
        qr:PermanenciaYanaqancha,
        qr:PreparacionPaucartambo,
        qr:ProcesionImagenTayankani,
        qr:RomeriaPaucartambo,
        qr:TrasladoCruzColquePunku ;
    qr:recorre qr:ItinerarioPaucartambo,
        qr:RutaColquePunkuSantuario,
        qr:RutaLomada,
        qr:RutaMahuayaniSantuario,
        qr:RutaOcongatePaucartambo,
        qr:RutaPaucartamboMahuayani,
        qr:RutaSantuarioColquePunku,
        qr:RutaTayankaniOcongate ;
    rdfs:comment "Agrupación de ukumaris que pertenece a Nación Paucartambo. Sus integrantes participan en los ensayos, la romería, la subida a Colque Punku, la Lomada, el Inti Alabado y otras actividades de la secuencia local. Entre sus integrantes se reconocen morocos y caporales."@es .

qr:cierraRecorrido a owl:ObjectProperty ;
    rdfs:label "cierra recorrido"@es ;
    rdfs:comment "Celebración que cierra la secuencia vivida del recorrido de Paucartambo."@es .

qr:continuaHacia a owl:ObjectProperty ;
    rdfs:label "continúa hacia"@es ;
    rdfs:comment "Relación de continuidad entre lugares o rutas de un recorrido conocido."@es .

qr:formaParteDe a owl:ObjectProperty ;
    rdfs:label "forma parte de"@es ;
    rdfs:comment "Relación entre agrupaciones, naciones y prácticas incluidas en una festividad."@es .

qr:identificadorGPS a owl:DatatypeProperty ;
    rdfs:label "Identificador GPS"@es .

qr:incluyeRol a owl:ObjectProperty ;
    rdfs:label "incluye rol"@es ;
    rdfs:comment "Rol desempeñado por integrantes de un colectivo."@es .

qr:incluyeRuta a owl:ObjectProperty ;
    rdfs:label "incluye ruta"@es ;
    rdfs:comment "Vincula el itinerario general con sus caminos estables."@es .

qr:iniciaEn a owl:ObjectProperty ;
    rdfs:label "inicia en"@es ;
    rdfs:comment "Lugar de inicio de una ruta."@es .

qr:inicioUTC a owl:DatatypeProperty ;
    rdfs:label "Inicio UTC"@es .

qr:longitudKm a owl:DatatypeProperty ;
    rdfs:label "Longitud del tramo, kilómetros"@es .

qr:modalidad a owl:DatatypeProperty ;
    rdfs:label "Modalidad de desplazamiento"@es .

qr:ocurreEn a owl:ObjectProperty ;
    rdfs:label "ocurre en"@es ;
    rdfs:comment "Lugar reconocido de una práctica recurrente."@es .

qr:participaEn a owl:ObjectProperty ;
    rdfs:label "participa en"@es ;
    rdfs:comment "Un colectivo participa en una práctica."@es .

qr:pasaPor a owl:ObjectProperty ;
    rdfs:label "pasa por"@es ;
    rdfs:comment "Hito intermedio conocido de una ruta, sin imponer un orden cuando este no está establecido."@es .

qr:recorre a owl:ObjectProperty ;
    rdfs:label "recorre"@es ;
    rdfs:comment "Colectivo que sigue una ruta en el recorrido descrito."@es .

qr:seRealizaEnRuta a owl:ObjectProperty ;
    rdfs:label "se realiza en ruta"@es ;
    rdfs:comment "Práctica que se desarrolla a lo largo de un camino."@es .

qr:sigueA a owl:ObjectProperty ;
    rdfs:label "sigue a"@es ;
    rdfs:comment "Orden habitual entre prácticas en la secuencia local descrita."@es .

qr:terminaEn a owl:ObjectProperty ;
    rdfs:label "termina en"@es ;
    rdfs:comment "Lugar de llegada de una ruta."@es .

qr:tieneRegistroVisual a owl:ObjectProperty ;
    rdfs:label "tiene registro visual"@es ;
    rdfs:comment "Vincula una práctica, lugar o ruta con el identificador de una imagen o video."@es .

qr:tieneTramoGPS a owl:ObjectProperty ;
    rdfs:label "tiene tramo GPS"@es ;
    rdfs:comment "Vincula una ruta conocida con un segmento de GPS registrado."@es .

qr:ubicadoEn a owl:ObjectProperty ;
    rdfs:label "ubicado en"@es ;
    rdfs:comment "Un lugar, sector o referencia espacial se encuentra dentro de otro."@es .

qr:usaObjeto a owl:ObjectProperty ;
    rdfs:label "usa objeto"@es ;
    rdfs:comment "Objeto empleado en una práctica."@es .

qr:vinculadoALugar a owl:ObjectProperty ;
    rdfs:label "vinculado a lugar"@es ;
    rdfs:comment "Vínculo conocido de un colectivo con una localidad; no supone exclusividad territorial."@es .

qr:BautizoMorocos a qr:PracticaCultural ;
    rdfs:label "Bautizo de morocos"@es ;
    qr:formaParteDe qr:FestividadQoylluriti ;
    qr:ocurreEn qr:ColquePunku,
        qr:GrutaTayankani ;
    qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_051_01,
        qr:Medio_QR_FOT_2025_051_02,
        qr:Medio_QR_FOT_2025_051_03,
        qr:Medio_QR_FOT_2025_051_04,
        qr:Medio_QR_FOT_2025_051_05 ;
    qr:usaObjeto qr:Sorriago ;
    rdfs:comment "Los morocos son integrantes en sus primeros años como ukumaris. Durante el ascenso a Colque Punku se realiza una iniciación en la que el moroco se arrodilla, recibe tres golpes con sorriago del caporal y después un abrazo. En el recorrido de Nación Paucartambo hay asimismo un momento de bautizo en la gruta de Tayankani, después del Inti Alabado. La experiencia de 2025 incluye el bautizo personal del participante en Tayankani. Los dos momentos se mencionan como parte de la trayectoria de los morocos; el modo preciso puede variar entre agrupaciones."@es .

qr:CapillaTayankani a qr:Lugar ;
    rdfs:label "Capilla de Tayankani"@es ;
    qr:ubicadoEn qr:Tayancani ;
    rdfs:comment "Lugar en que permanece la imagen del Señor de Tayankani durante parte del calendario local."@es .

qr:Caporal a qr:Rol ;
    rdfs:label "Caporal"@es ;
    rdfs:comment "Rol de conducción de la agrupación en determinadas actividades. En el bautizo de morocos se describe el uso del sorriago, seguido de un abrazo. En Wataskama los caporales participan en bromas durante los cruces."@es .

qr:CeldaUkukusPaucartambo a qr:Lugar ;
    rdfs:label "Celda de los ukumaris de Paucartambo"@es ;
    qr:ubicadoEn qr:SantuarioQoylluriti ;
    rdfs:comment "Espacio utilizado para dejar equipo, preparar comida y descansar en el sector del Santuario, próximo al sendero de subida a Colque Punku. Se encuentra en el entorno de bofedal."@es .

qr:CementerioPaucartambo a qr:Lugar ;
    rdfs:label "Cementerio de Paucartambo"@es ;
    qr:ubicadoEn qr:Paucartambo ;
    rdfs:comment "La romería visita y recuerda a antiguos integrantes de las danzas y familiares fallecidos antes de iniciar el viaje."@es .

qr:CruzColquePunku a qr:Objeto ;
    rdfs:label "Cruz de Colque Punku"@es ;
    rdfs:comment "La cruz es llevada hacia arriba, a la zona de gruta de Colque Punku, el día anterior a su descenso. Después, ukumaris de distintas naciones participan por turnos en transportarla hacia abajo. Durante el traslado pueden producirse juegos y disputas físicamente intensas entre los participantes."@es .

qr:DespedidaMachuCruz a qr:PracticaCultural ;
    rdfs:label "Pausa de despedida en Machu Cruz"@es ;
    qr:formaParteDe qr:FestividadQoylluriti,
        qr:Lomada ;
    qr:ocurreEn qr:MachuCruz ;
    qr:seRealizaEnRuta qr:RutaLomada ;
    rdfs:comment "En el recorrido de la Lomada aparece Machu Cruz, donde se describe una pausa para compartir maíz y queso como despedida antes de seguir caminando. La pausa ocurre durante el desplazamiento y se continúa caminando después de compartir alimentos."@es .

qr:DespedidaYanaqocha a qr:PracticaCultural ;
    rdfs:label "Despedida en Yanaqocha"@es ;
    qr:formaParteDe qr:FestividadQoylluriti,
        qr:Lomada ;
    qr:ocurreEn qr:Yanaqocha ;
    qr:seRealizaEnRuta qr:RutaLomada ;
    rdfs:comment "En la laguna Yanaqocha los integrantes de la Nación se despiden con carreras y abrazos durante la Lomada."@es .

qr:GrutaColquePunku a qr:Lugar ;
    rdfs:label "Gruta de Colque Punku"@es ;
    qr:ubicadoEn qr:ColquePunku ;
    rdfs:comment "Sector de la cruz que se asciende previamente y se desciende después. Se distingue de la gruta utilizada por los ukumaris de Paucartambo en Tayankani."@es .

qr:GrutaTayankani a qr:Lugar ;
    rdfs:label "Gruta de Tayankani"@es ;
    qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_051_01,
        qr:Medio_QR_FOT_2025_051_02,
        qr:Medio_QR_FOT_2025_051_03,
        qr:Medio_QR_FOT_2025_051_04,
        qr:Medio_QR_FOT_2025_051_05 ;
    qr:ubicadoEn qr:Tayancani ;
    rdfs:comment "Gruta utilizada por los ukumaris de Nación Paucartambo para un momento del bautizo de morocos después del Inti Alabado."@es .

qr:IglesiaPaucartambo a qr:Lugar ;
    rdfs:label "Iglesia de Paucartambo"@es ;
    qr:ubicadoEn qr:Paucartambo ;
    rdfs:comment "Se celebra la misa previa a la partida. El recorrido por el pueblo también pasa por la iglesia."@es .

qr:ImagenSenorTayankani a qr:Objeto ;
    rdfs:label "Imagen del Señor de Tayankani"@es ;
    rdfs:comment "Imagen relacionada con procesiones y desplazamientos entre el Santuario, Tayankani y Ocongate, tal como se describe en el recorrido y en el TTL histórico."@es .

qr:LaderaYanaqancha a qr:Lugar ;
    rdfs:label "Cerro de Yanaqancha"@es ;
    qr:ubicadoEn qr:Yanaqancha ;
    rdfs:comment "Ladera donde parte de los ukumaris participa en una danza durante la parada en Yanaqancha."@es .

qr:Mamachapata a qr:Lugar ;
    rdfs:label "Mamachapata"@es ;
    qr:ubicadoEn qr:SantuarioQoylluriti ;
    rdfs:comment "Sector del Santuario hacia el que se dirige la procesión con la imagen del Señor de Tayankani."@es .

qr:Moroco a qr:Rol ;
    rdfs:label "Moroco"@es ;
    rdfs:comment "Integrante de los primeros años entre los ukumaris, habitualmente los dos o tres primeros. Durante la Lomada, en especial en los primeros dos años, se encarga de trasladar queperinas y otros bultos a las zonas de descanso, mientras otros participan en actividades colectivas."@es .

qr:Nacion a owl:Class ;
    rdfs:label "Nación de la peregrinación"@es ;
    rdfs:subClassOf qr:Colectivo .

qr:QquchiyocWayqo a qr:Lugar ;
    rdfs:label "Qquchiyoc Wayq’o"@es ;
    rdfs:comment "Quebrada con un riachuelo en el camino de la Lomada, en el sector comprendido entre Yanaqancha y Q’espi Cruz."@es .

qr:RiachueloWataskama a qr:Lugar ;
    rdfs:label "Riachuelo de Wataskama"@es ;
    qr:ubicadoEn qr:Wataskama ;
    rdfs:comment "Referencia física del lugar donde se corre y se cruza de una orilla a otra durante el encuentro."@es .

qr:RomeriaPaucartambo a qr:PracticaCultural ;
    rdfs:label "Romería en Paucartambo"@es ;
    qr:formaParteDe qr:FestividadQoylluriti,
        qr:PreparacionPaucartambo ;
    qr:ocurreEn qr:CementerioPaucartambo ;
    rdfs:comment "Después de la misa y antes de la partida se visita el cementerio de Paucartambo. Allí se recuerda a los integrantes de las danzas que ya murieron, a los antiguos y a los familiares fallecidos. La visita es parte de la preparación del grupo, antes de regresar a las calles y salir en camiones."@es .

qr:Sinakara a qr:Lugar ;
    rdfs:label "Sinakara"@es ;
    rdfs:comment "Entorno de montaña en el que está el Santuario de Qoyllur Rit’i. En la experiencia relatada se reconoce a Sinakara como apu."@es .

qr:Sorriago a qr:Objeto ;
    rdfs:label "Sorriago"@es ;
    rdfs:comment "Elemento utilizado por el caporal durante el bautizo de morocos, con golpes rituales seguidos de un abrazo, según lo descrito para la experiencia del grupo."@es .

