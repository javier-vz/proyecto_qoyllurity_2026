        qr26:Tramo08,
        qr26:Tramo09 ;
    rdfs:comment "Camino de unas 24 horas que comienza en el Santuario después del descenso de Colque Punku y sigue hacia Tayankani. En el recorrido se encuentran Wataskama, Yanaqancha, Q’espi Cruz, Yanaqocha, Machu Cruz y el paso por Escalerachayoq, aunque las posiciones de ciertos hitos secundarios aún deben fijarse con el GPS y la memoria de campo. La marcha combina sectores abiertos, bajadas pronunciadas, descansos cortos y un tramo nocturno muy exigente."@es .

qr:TramoGPS a owl:Class ;
    rdfs:label "Tramo de trayectoria GPS"@es .

qr:SantuarioQoylluriti a qr:Lugar ;
    rdfs:label "Santuario del Señor de Qoyllur Rit’i"@es ;
    qr:continuaHacia qr:ColquePunku,
        qr:Wataskama ;
    qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_040_02,
        qr:Medio_QR_FOT_2025_040_03,
        qr:Medio_QR_FOT_2025_040_04,
