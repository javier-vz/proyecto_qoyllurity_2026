        qr:Medio_QR_VID_2025_040_01 ;
    qr:ubicadoEn qr:Sinakara ;
    rdfs:comment "Lugar de llegada desde Mahuayani, concentración de peregrinos y agrupaciones, misa, campamento y punto de partida del ascenso a Colque Punku y de la Lomada."@es .

qr:FestividadQoylluriti a qr:Festividad ;
    rdfs:label "Qoyllur Rit’i"@es ;
    qr:seRealizaEnRuta qr:ItinerarioPaucartambo ;
    qr:tieneRegistroVisual qr:Medio_QR_FOT_2026_DRON_0009,
        qr:Medio_QR_FOT_2026_DRON_0010,
        qr:Medio_QR_FOT_2026_DRON_0011,
        qr:Medio_QR_FOT_2026_DRON_0012,
        qr:Medio_QR_FOT_2026_DRON_0013,
        qr:Medio_QR_FOT_2026_DRON_0014,
        qr:Medio_QR_FOT_2026_DRON_0015,
        qr:Medio_QR_FOT_2026_DRON_0016,
        qr:Medio_QR_FOT_2026_DRON_0017,
        qr:Medio_QR_FOT_2026_DRON_0018,
        qr:Medio_QR_FOT_2026_DRON_0019,
        qr:Medio_QR_FOT_2026_DRON_0020,
        qr:Medio_QR_FOT_2026_DRON_0021,
        qr:Medio_QR_FOT_2026_DRON_0022,
        qr:Medio_QR_FOT_2026_DRON_0023,
        qr:Medio_QR_FOT_2026_DRON_0024,
        qr:Medio_QR_FOT_2026_DRON_0025,
        qr:Medio_QR_FOT_2026_DRON_0026,
        qr:Medio_QR_FOT_2026_DRON_0027,
        qr:Medio_QR_FOT_2026_DRON_0028 ;
    rdfs:comment "La peregrinación conecta Paucartambo, Ccatcca, Ocongate, Mahuayani, el Santuario de Sinakara, Colque Punku y el recorrido de la Lomada hacia Tayankani. La experiencia aquí descrita corresponde principalmente al camino de Nación Paucartambo y sus agrupaciones. La secuencia incluye preparativos, romería, viaje en camiones, subida al Santuario y a Colque Punku, traslado de la cruz, Lomada, descanso en Yanaqancha e Inti Alabado, antes del regreso a Ocongate y Paucartambo. Los días ayudan a narrar el itinerario; los mismos lugares y prácticas permanecen reconocibles entre años."@es .

qr:PracticaCultural a owl:Class ;
    rdfs:label "Práctica cultural recurrente"@es .

