# Consulta 1 — Prácticas y lugares observados
PREFIX qr: <http://example.org/festividades#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?actividad ?nombre ?practica ?lugar WHERE {
  ?actividad qr:instanciaDePractica ?practica .
  OPTIONAL { ?actividad qr:ocurreEnLugar ?lugar . }
  OPTIONAL { ?actividad rdfs:label ?nombre . }
}
ORDER BY ?nombre

# Consulta 2 — Participantes de un encuentro documentado sin fotografía
PREFIX qr: <http://example.org/festividades#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?grupo ?nombre WHERE {
  qr:EncuentroWataskamaDocumentado qr:participaColectivo ?grupo .
  ?grupo rdfs:label ?nombre .
}

# Consulta 3 — Tramos GPS del recorrido de 2026
PREFIX qr26: <urn:qoylluriti:registro2026:>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?tramo ?nombre WHERE {
  qr26:RecorridoRegistrado2026 qr26:contieneTramo ?tramo .
  ?tramo rdfs:label ?nombre .
}
ORDER BY ?tramo
