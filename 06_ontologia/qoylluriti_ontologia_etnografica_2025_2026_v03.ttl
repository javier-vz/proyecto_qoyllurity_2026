    rdfs:range qr:ObjetoRitual .

dcterms:date a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

<http://www.semanticweb.org/jvera/ontologies/2026/1/untitled-ontology-10> a owl:Ontology .

geo1:lat a owl:AnnotationProperty .

geo1:long a owl:AnnotationProperty .

qr26:NacionPaucartambo a qr26:Grupo ;
    rdfs:label "Nación Paucartambo"@es ;
    dcterms:source "UNESCO, expediente 00567: nación identificada por denominación de origen; la relación no implica pertenencia de participantes fotografiados ni de todas las trazas GPS"@es ;
    owl:sameAs qr:NacionPaucartambo ;
    qr26:vinculadoALugar qr26:Paucartambo .

qr26:asociadoAGrupo a owl:ObjectProperty ;
    rdfs:label "asociado a grupo"@es ;
    rdfs:comment "Relación reservada para adscripción de tramos o recorridos a colectivos solo con evidencia específica"@es .

qr26:contieneTramo a owl:ObjectProperty ;
    rdfs:label "contiene tramo"@es ;
    rdfs:comment "Vincula el registro global con las trazas que lo componen"@es .

qr26:inicioUTC a owl:DatatypeProperty .

qr26:longitudKm a owl:DatatypeProperty .

qr26:mencionaLugar a owl:ObjectProperty ;
    rdfs:label "menciona lugar"@es ;
    rdfs:comment "El topónimo figura en el nombre original del archivo GPX; no es una comprobación espacial"@es .

qr26:modalidad a owl:DatatypeProperty .

qr26:ontologia a owl:Ontology ;
    rdfs:label "Grafo documental mínimo de Qoyllur Rit’i 2026 (copia de edición Protégé)"@es .

qr26:proximoAReferencia a owl:ObjectProperty ;
    rdfs:label "próximo a referencia"@es ;
    rdfs:comment "La polilínea GPX se aproximó a menos de 200 metros de un waypoint de campo guardado; ver CSV de evidencia"@es .

qr26:vinculadoALugar a owl:ObjectProperty ;
    rdfs:label "vinculado a lugar"@es ;
    rdfs:comment "Relación documental entre entidad de grupo y topónimo, atribuida a fuente explícita"@es .

qr:Anual a qr:Periodicidad,
        owl:NamedIndividual ;
    rdfs:label "Anual"@es .

qr:Articulo a owl:Class ;
    rdfs:subClassOf qr:FuenteBibliografica .

qr:AscensoColquePunku2026 a qr:Actividad,
        owl:NamedIndividual ;
    rdfs:label "Ascenso desde Santuario a Colque Punku (2026)"@es ;
