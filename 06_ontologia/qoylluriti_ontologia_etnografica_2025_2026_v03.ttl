    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range xsd:dateTime .

qr:tieneHoraInicio a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "tiene hora de inicio"@es ;
    rdfs:comment "Hora de inicio. Formato: HH:MM:SS."@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range xsd:time .

qr:tieneImportancia a owl:DatatypeProperty ;
    rdfs:label "tiene importancia"@es ;
    rdfs:comment "Nivel de importancia: 'central' (núcleo de la festividad), 'secundario' (importante pero no esencial), 'menor' (complementario)."@es ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

qr:tieneNombreArchivo a owl:DatatypeProperty ;
    rdfs:label "tiene nombre de archivo"@es ;
    rdfs:comment "Nombre original del archivo multimedia."@es ;
    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range xsd:string .

qr:tieneNombreConjunto a owl:DatatypeProperty ;
    rdfs:label "tiene nombre del conjunto"@es ;
    rdfs:domain qr:ConjuntoMultimedia ;
    rdfs:range xsd:string .

qr:tieneNombreLocal a owl:DatatypeProperty ;
    rdfs:domain qr:EventoRitual,
        qr:Lugar ;
    rdfs:range xsd:string .

qr:tieneOrden a owl:DatatypeProperty ;
    rdfs:comment "Orden secuencial de los marcos temporales (días) en la festividad"@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range xsd:integer .

qr:tieneOrdenEvento a owl:DatatypeProperty ;
    rdfs:comment "Orden del evento dentro de su marco temporal específico"@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range xsd:integer .

qr:tieneTipoArchivo a owl:DatatypeProperty ;
    rdfs:label "tiene tipo de archivo"@es ;
