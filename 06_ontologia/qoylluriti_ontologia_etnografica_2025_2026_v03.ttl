qr:Vestimenta a owl:Class ;
    rdfs:label "Vestimenta"@es ;
    rdfs:comment "Indumentaria ceremonial."@es ;
    rdfs:subClassOf qr:ObjetoRitual .

qr:TrajeUkumari a qr:Vestimenta,
        owl:NamedIndividual ;
    rdfs:label "Traje de Ukumari"@es ;
    qr:hechoDeRitual "lana"@es ;
    qr:tieneParte qr:CamisaBlanca,
        qr:CruzCobreUkuku,
        qr:GuantesUkuku,
        qr:Huaqollo,
        qr:Pellon,
        qr:Puyka,
        qr:SilbatoUkuku,
        qr:Sorriago,
        qr:Umakhara ;
    rdfs:comment "Vestimenta ceremonial completa del ukuku que incluye: pellón (traje principal de lana), huaqollo (careta tejida de lana que cubre el rostro), umak'ara (pedazo de cuero en la cabeza), sorriago (látigo ceremonial de cuero trenzado), cruz de cobre portada en el pecho, silbato para anunciarse, puyka (caña para hacer ruido que imita a los osos), guantes y camisa blanca. El conjunto representa al oso andino y sus funciones rituales."@es .

qr26:LugarReferencia a owl:Class ;
