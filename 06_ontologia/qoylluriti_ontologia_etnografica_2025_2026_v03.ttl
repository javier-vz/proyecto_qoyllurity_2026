qr:ZigzagIntiAlabado2025 a qr:Actividad,
        owl:NamedIndividual ;
    rdfs:label "Zigzag del Inti Alabado, 2025"@es ;
    qr:anioObservado 2025 ;
    qr:detalleEtnografico "Desplazamiento colectivo en zigzag descrito por participante; no se interpreta su significado ritual."@es ;
    qr:instanciaDePractica qr:PracticaIntiAlabado ;
    qr:ocurreEnLugar qr:Tayancani ;
    qr:participaColectivo qr:UkumarisVariasNaciones ;
