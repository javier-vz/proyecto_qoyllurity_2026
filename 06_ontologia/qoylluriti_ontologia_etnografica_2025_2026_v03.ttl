    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range xsd:anyURI .

qr:usaVestimenta a owl:ObjectProperty ;
    rdfs:label "usa vestimenta"@es ;
    rdfs:comment "Relación entre un danzante y su traje ceremonial."@es ;
    rdfs:domain qr:Danzante ;
    rdfs:range qr:Vestimenta .

qr:utilizaObjeto a owl:ObjectProperty ;
