qr:RecepcionOcongateDocumentada a qr:Actividad,
        owl:NamedIndividual ;
    rdfs:label "Recibimiento en Ocongate"@es ;
    qr:detalleEtnografico "Al llegar a Ocongate, los peregrinos son recibidos con alegría por personas del pueblo. El participante recuerda muestras de hospitalidad, incluido el ofrecimiento de chicha. Esta afirmación procede del testimonio; la entrega puntual no se identifica inequívocamente en las fotografías."@es ;
    qr:estadoRevision "testimonio_y_fotos_anio_pendiente",
        "Por confirmar: año de las cinco fotografías del recorrido y la cancha de Ocongate."@es ;
    qr:instanciaDePractica qr:PracticaRecepcionOcongate ;
    qr:ocurreEnLugar qr:Ocongate ;
    qr:participaColectivo qr:PobladoresOcongate ;
    qr:sigueA qr:CaminoTayankaniOcongateDocumentado ;
    dcterms:source "Testimonio directo del investigador-participante de los ukumaris de Nación Paucartambo, entrevistas de reconstrucción etnográfica sobre las peregrinaciones 2025–2026."@es .

qr:RecorridoPuebloPaucartambo2025 a qr:Actividad,
