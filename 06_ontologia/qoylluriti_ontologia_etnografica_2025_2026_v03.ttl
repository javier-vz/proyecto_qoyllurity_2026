qr:PasoCasaPrioste a qr:Actividad,
        qr:EventoRitual,
        owl:NamedIndividual ;
    rdfs:label "Paso por la casa del prioste (2025)"@es ;
    qr:anioObservado 2025 ;
    qr:antesDe qr:ViajeVehicular_Paucartambo_Mahuayani_2025 ;
    qr:detalleEtnografico "Durante el viaje existe una parada en casa de un prioste, en la que se encuentran ukumaris, Qollas y Chunchus y se comparte descanso y comida. La casa se considera referencia contextual y se reserva su ubicación particular."@es ;
    qr:instanciaDePractica qr:PracticaParadaPrioste ;
    qr:ocurreEnLugar qr:CasaPriosteParada ;
    qr:participaColectivo qr:ChunchusPaucartambo,
