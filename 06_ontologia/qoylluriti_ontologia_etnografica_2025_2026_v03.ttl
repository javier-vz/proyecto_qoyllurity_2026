qr:anioObservado a owl:DatatypeProperty ;
    rdfs:label "año de la observación"@es .

qr:antesDe a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "antes de"@es ;
    rdfs:comment "Orden temporal. Transitiva: si A es antes de B y B es antes de C, entonces A es antes de C."@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:EventoRitual .

qr:asociadaAFestividad a owl:ObjectProperty ;
    rdfs:label "actividad asociada a festividad"@es .

qr:autor a owl:DatatypeProperty ;
    rdfs:domain qr:FuenteBibliografica ;
    rdfs:range xsd:string .

qr:cantidadAproximada a owl:DatatypeProperty ;
    rdfs:domain qr:Danzante ;
    rdfs:range xsd:string .

qr:cierraItinerarioDe a owl:ObjectProperty ;
    rdfs:label "marca el cierre de un itinerario documentado"@es .

qr:colectivoDeNacion a owl:ObjectProperty ;
    rdfs:label "colectivo que forma parte de una nación"@es .

qr:condicionAcceso a owl:DatatypeProperty ;
    rdfs:label "nivel de difusión recomendado"@es .

qr:conduceA a owl:ObjectProperty ;
    rdfs:label "conduce a"@es ;
    rdfs:range qr:Lugar .

qr:contiene a owl:ObjectProperty ;
    rdfs:label "contiene"@es ;
    rdfs:comment "Indica que un lugar contiene geográficamente a otro."@es ;
    rdfs:domain qr:Lugar ;
    rdfs:range qr:Lugar ;
    owl:inverseOf qr:estaEn .

qr:contieneActividad a owl:ObjectProperty ;
    rdfs:label "contiene actividad"@es .

qr:defineMarcoTemporal a owl:ObjectProperty ;
    rdfs:label "define marco temporal" ;
    rdfs:comment "Este evento ritual define el tiempo en que ocurren otros eventos rituales"@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:EventoRitual .

qr:desde a owl:ObjectProperty ;
    rdfs:label "desde"@es ;
    rdfs:range qr:Lugar .

qr:detalleEtnografico a owl:DatatypeProperty ;
    rdfs:label "descripción etnográfica de la actividad"@es .

qr:documentaEvento a owl:ObjectProperty ;
    rdfs:label "documenta evento"@es ;
    rdfs:comment "Relaciona un recurso multimedia con el evento ritual específico que captura."@es ;
    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range qr:EventoRitual .

qr:documentaLugar a owl:ObjectProperty ;
    rdfs:label "documenta lugar"@es ;
    rdfs:comment "Relaciona un recurso multimedia con el lugar específico donde fue capturado."@es ;
    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range qr:Lugar .

qr:documentaParticipante a owl:ObjectProperty ;
    rdfs:label "documenta participante"@es ;
    rdfs:comment "Relaciona un recurso multimedia con participantes individuales o colectivos que aparecen en él."@es ;
    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range qr:Participante .

qr:documentaPracticaCultural a owl:ObjectProperty ;
    rdfs:label "documenta práctica cultural"@es ;
    rdfs:comment "Relaciona un recurso multimedia con prácticas culturales específicas que muestra."@es ;
    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range qr:PracticaCultural .

qr:documentadoEnRecorrido a owl:ObjectProperty ;
    rdfs:label "edición documentada parcialmente por recorrido GPS"@es .

qr:edicionDe a owl:ObjectProperty ;
    rdfs:label "edición anual de una festividad"@es .

qr:ejecutaDanza a owl:ObjectProperty ;
    rdfs:comment "Relación entre un danzante y la danza en la que participa."@es,
        "ejecuta danza"@es ;
    rdfs:domain qr:Danzante ;
    rdfs:range qr:Danza .

qr:esParteDe a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "es parte de"@es ;
    rdfs:comment "Indica que un objeto es componente de otro objeto mayor. Transitiva: si A es parte de B y B es parte de C, entonces A es parte de C."@es ;
    rdfs:domain qr:ObjetoRitual ;
    rdfs:range qr:ObjetoRitual ;
    owl:inverseOf qr:tieneParte .

qr:esParteDeConjunto a owl:ObjectProperty ;
    rdfs:label "es parte de conjunto"@es ;
    rdfs:comment "Agrupa recursos multimedia relacionados (ej: todas las fotos de un mismo evento)."@es ;
    rdfs:domain qr:RecursoMultimedia ;
    rdfs:range qr:ConjuntoMultimedia .

qr:esParteDeFestividad a owl:ObjectProperty ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:Festividad .

qr:esParteDelApu a owl:ObjectProperty ;
    rdfs:label "es parte del apu"@es ;
    rdfs:comment "Indica que un lugar sagrado forma parte de un apu (espíritu de montaña)."@es ;
    rdfs:domain qr:LugarSagrado ;
    rdfs:range qr:Apu .

qr:esPeriodicoCon a owl:ObjectProperty ;
    rdfs:label "es periódico con"@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:Periodicidad .

qr:esPortadoPor a owl:ObjectProperty ;
    rdfs:label "es portado por"@es ;
    rdfs:comment "Un objeto es portado por participante(s)."@es ;
    rdfs:domain qr:ObjetoRitual ;
    rdfs:range qr:Participante ;
    owl:inverseOf qr:portaObjeto .

qr:esUsadoPor a owl:ObjectProperty ;
    rdfs:label "es usado por"@es ;
    rdfs:comment "Un objeto ritual es usado por participante(s)."@es ;
    rdfs:domain qr:ObjetoRitual ;
    rdfs:range qr:Participante ;
    owl:inverseOf qr:usaObjetoRitual .

qr:estaConformadaPor a owl:ObjectProperty ;
    rdfs:label "está conformada por"@es ;
    rdfs:comment "Distritos o comunidades que conforman una nación."@es ;
    rdfs:domain qr:Nacion ;
    rdfs:range qr:Lugar ;
    owl:inverseOf qr:perteneceA .

qr:estadoRevision a owl:DatatypeProperty ;
    rdfs:label "estado de revisión de esta afirmación"@es .

qr:hechoDeRitual a owl:DatatypeProperty ;
    rdfs:label "hecho de"@es ;
    rdfs:comment "Material del que está hecho el objeto ritual."@es ;
    rdfs:domain qr:ObjetoRitual ;
    rdfs:range xsd:string .

qr:instanciaDePractica a owl:ObjectProperty ;
    rdfs:label "actividad documentada de una práctica recurrente"@es ;
    rdfs:domain qr:Actividad ;
    rdfs:range qr:PracticaCultural .

qr:involucraObjeto a owl:ObjectProperty ;
    rdfs:label "objeto material usado o referido en una actividad"@es .

qr:involucraRol a owl:ObjectProperty ;
    rdfs:label "rol presente en una actividad"@es .

qr:ocurreEnLugar a owl:ObjectProperty ;
    rdfs:domain qr:Actividad ;
    rdfs:range qr:Lugar .

qr:participaColectivo a owl:ObjectProperty ;
    rdfs:label "colectivo participante en una actividad"@es .

qr:participaEn a owl:ObjectProperty ;
    rdfs:label "participa en"@es ;
    rdfs:comment "Relación general de participación."@es ;
    rdfs:domain qr:Participante ;
    rdfs:range qr:EventoRitual ;
    owl:inverseOf qr:realizadoPor .

qr:pasaPor a owl:ObjectProperty ;
    rdfs:label "pasa por"@es ;
    rdfs:comment "Indica que un trayecto/ruta pasa por un lugar específico"@es ;
    rdfs:range qr:Lugar .

qr:seAsociaARecorrido a owl:ObjectProperty ;
    rdfs:label "actividad asociada a recorrido narrado"@es .

qr:seRelacionaConTramoGPS a owl:ObjectProperty ;
    rdfs:label "relación documental con un tramo GPS"@es .

qr:sigueA a owl:ObjectProperty ;
    rdfs:label "actividad posterior a otra actividad documentada"@es .

qr:sigueRuta a owl:ObjectProperty ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:RecorridoCultural .

qr:sucedeInmediatamenteA a owl:ObjectProperty ;
    rdfs:label "sucede inmediatamente a"@es ;
    rdfs:comment "Sucesión temporal directa. NO transitiva porque 'inmediatamente' implica sin intermedios."@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:EventoRitual .

qr:tieneAltitudMetros a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "tiene altitud en metros"@es ;
    rdfs:comment "Altitud sobre el nivel del mar en metros."@es ;
