    rdfs:comment "Duración en horas. Funcional: un evento tiene UNA SOLA duración."@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range xsd:decimal .

qr:tieneEtapa a owl:ObjectProperty ;
    rdfs:label "itinerario incluye etapa o actividad"@es .

qr:tieneFecha a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "tieneFecha",
        "tiene fecha"@es ;
    rdfs:comment "Fecha específica. Formato: YYYY-MM-DD."@es ;
    rdfs:domain qr:EventoRitual ;
