qr:Paucartambo a qr:Lugar,
        owl:NamedIndividual ;
    rdfs:label "Paucartambo" ;
    rdfs:comment "Paucartambo es un pueblo andino de la región Cusco con una vida ritual intensa, en torno a festividades como la Virgen del Carmen y su participación regional en la peregrinación al Señor de Qoyllur Rit’i. Funciona como espacio de reunión, organización y partida de danzantes y peregrinos."@es .

qr:Tayancani a qr:Lugar,
        owl:NamedIndividual ;
    rdfs:label "Tayancani" ;
    rdfs:comment "Localidad donde se deposita la imagen al final de la peregrinación"@es ;
    skos:altLabel "Tayankani"@es .

