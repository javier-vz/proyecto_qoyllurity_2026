qr:estaEn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "está ubicado en"@es ;
    rdfs:comment "Un lugar está contenido geográficamente dentro de otro lugar. Transitiva: si A está en B y B está en C, entonces A está en C."@es ;
    rdfs:range qr:Lugar .

qr:perteneceA a owl:ObjectProperty ;
    rdfs:label "pertenece a"@es ;
    rdfs:comment "Relación de un participante con su nación."@es ;
    rdfs:domain qr:Participante ;
    rdfs:range qr:Nacion .

qr:portaObjeto a owl:ObjectProperty ;
    rdfs:label "porta objeto"@es ;
    rdfs:comment "Objeto portado por participante."@es ;
    rdfs:domain qr:Participante ;
    rdfs:range qr:ObjetoRitual .

qr:realizadoPor a owl:ObjectProperty ;
    rdfs:label "realizado por"@es ;
    rdfs:comment "Especifica el participante principal de un evento."@es ;
    rdfs:domain qr:EventoRitual ;
    rdfs:range qr:Participante .

qr:tieneParte a owl:ObjectProperty ;
    rdfs:label "tiene parte"@es ;
    rdfs:comment "Relaciona un objeto compuesto con sus componentes. Permite modelar objetos rituales que están formados por múltiples partes."@es ;
    rdfs:domain qr:ObjetoRitual ;
    rdfs:range qr:ObjetoRitual .

qr:usaObjetoRitual a owl:ObjectProperty ;
    rdfs:label "usa objeto ritual"@es ;
    rdfs:domain qr:Participante ;
    rdfs:range qr:ObjetoRitual .

