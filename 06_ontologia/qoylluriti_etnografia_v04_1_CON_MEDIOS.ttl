                  qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_051_01 ,
                                         qr:Medio_QR_FOT_2025_051_02 ,
                                         qr:Medio_QR_FOT_2025_051_03 ,
                                         qr:Medio_QR_FOT_2025_051_04 ,
                                         qr:Medio_QR_FOT_2025_051_05 ;
                  qr:ubicadoEn qr:Tayancani ;
                  rdfs:comment "Gruta utilizada por los ukumaris de Nación Paucartambo para un momento del bautizo de morocos después del Inti Alabado."@es ;
                  rdfs:label "Gruta de Tayankani"@es .


###  http://example.org/festividades#GrutaYanaqancha
qr:GrutaYanaqancha rdf:type owl:NamedIndividual ,
                            qr:Lugar ;
                   qr:ubicadoEn qr:Yanaqancha ;
                   rdfs:comment "Sector de gruta por el que transcurre parte de la ruta de la Lomada en las inmediaciones de Yanaqancha."@es ;
                   rdfs:label "Gruta de Yanaqancha"@es .


###  http://example.org/festividades#Huancarani
qr:Huancarani rdf:type owl:NamedIndividual ,
                       qr:Lugar ;
              qr:continuaHacia qr:Ccatcca ;
              rdfs:comment "Localidad y punto de paso en el recorrido vehicular desde Paucartambo hacia Ccatcca."@es ;
              rdfs:label "Huancarani"@es .


###  http://example.org/festividades#IglesiaCcatcca
qr:IglesiaCcatcca rdf:type owl:NamedIndividual ,
                           qr:Lugar ;
                  qr:ubicadoEn qr:Ccatcca ;
                  rdfs:comment "Iglesia señalada como lugar de visita durante la parada de la peregrinación."@es ;
                  rdfs:label "Iglesia de Ccatcca"@es .


###  http://example.org/festividades#IglesiaPaucartambo
qr:IglesiaPaucartambo rdf:type owl:NamedIndividual ,
                               qr:Lugar ;
                      qr:ubicadoEn qr:Paucartambo ;
                      rdfs:comment "Se celebra la misa previa a la partida. El recorrido por el pueblo también pasa por la iglesia."@es ;
                      rdfs:label "Iglesia de Paucartambo"@es .


###  http://example.org/festividades#ImagenSenorTayankani
qr:ImagenSenorTayankani rdf:type owl:NamedIndividual ,
                                 qr:Objeto ;
                        rdfs:comment "Imagen relacionada con procesiones y desplazamientos entre el Santuario, Tayankani y Ocongate, tal como se describe en el recorrido y en el TTL histórico."@es ;
                        rdfs:label "Imagen del Señor de Tayankani"@es .


###  http://example.org/festividades#IntiAlabado
qr:IntiAlabado rdf:type owl:NamedIndividual ,
                        qr:PracticaCultural ;
               qr:formaParteDe qr:FestividadQoylluriti ,
                               qr:Lomada ;
               qr:ocurreEn qr:Tayancani ;
               qr:seRealizaEnRuta qr:RutaLomada ;
               qr:sigueA qr:PermanenciaYanaqancha ;
               qr:tieneRegistroVisual qr:Medio_QR_MED_2025_050_01 ,
                                      qr:Medio_QR_MED_2025_050_02 ,
                                      qr:Medio_QR_MED_2025_050_03 ,
                                      qr:Medio_QR_MED_2025_050_04 ,
                                      qr:Medio_QR_MED_2025_050_05 ,
                                      qr:Medio_QR_MED_2025_050_06 ,
                                      qr:Medio_QR_MED_2025_050_07 ,
                                      qr:Medio_QR_MED_2025_050_08 ,
                                      qr:Medio_QR_MED_2025_050_09 ,
                                      qr:Medio_QR_MED_2025_050_10 ,
                                      qr:Medio_QR_MED_2026_050_01 ,
                                      qr:Medio_QR_MED_2026_050_02 ,
                                      qr:Medio_QR_MED_2026_050_03 ,
                                      qr:Medio_QR_MED_2026_050_04 ,
                                      qr:Medio_QR_MED_2026_050_05 ,
                                      qr:Medio_QR_MED_2026_050_06 ,
                                      qr:Medio_QR_MED_2026_050_07 ,
                                      qr:Medio_QR_MED_2026_050_08 ,
                                      qr:Medio_QR_MED_2026_050_09 ,
                                      qr:Medio_QR_MED_2026_050_10 ,
                                      qr:Medio_QR_MED_2026_050_11 ;
               qr:usaObjeto qr:BanderasNaciones ,
                            qr:Queperina ;
               rdfs:comment "Al amanecer en Tayankani, al final de la Lomada, las queperinas se reúnen en un mismo sector. Los ukumaris de diferentes naciones se forman en filas y después realizan desplazamientos en zigzag, corriendo y bailando por la ladera. Las fotografías de 2025 muestran el comienzo de la secuencia, con las queperinas reunidas, y luego la formación; las de 2026 permiten observar las filas y los desplazamientos desde otros momentos. El significado específico de la forma en zigzag permanece abierto. Después se desarrollan otros momentos de los ukumaris, incluido el bautizo de morocos de Paucartambo en su gruta."@es ;
               rdfs:label "Inti Alabado"@es .


###  http://example.org/festividades#ItinerarioPaucartambo
qr:ItinerarioPaucartambo rdf:type owl:NamedIndividual ,
                                  qr:Ruta ;
                         qr:incluyeRuta qr:RutaColquePunkuSantuario ,
                                        qr:RutaLomada ,
                                        qr:RutaMahuayaniSantuario ,
                                        qr:RutaOcongatePaucartambo ,
                                        qr:RutaPaucartamboMahuayani ,
                                        qr:RutaSantuarioColquePunku ,
                                        qr:RutaTayankaniOcongate ;
                         qr:iniciaEn qr:Paucartambo ;
                         qr:terminaEn qr:Paucartambo ;
                         rdfs:comment "Itinerario que parte de Paucartambo, continúa por los caminos hacia Mahuayani, el Santuario y Colque Punku, sigue en la Lomada hasta Tayankani, llega a Ocongate y regresa a Paucartambo. Describe la secuencia vivida con Nación Paucartambo, con medios y detalles de 2025 y 2026. Las etapas de retorno cierran el ciclo espacial."@es ;
                         rdfs:label "Itinerario de Nación Paucartambo"@es .


###  http://example.org/festividades#LaderaYanaqancha
qr:LaderaYanaqancha rdf:type owl:NamedIndividual ,
                             qr:Lugar ;
                    qr:ubicadoEn qr:Yanaqancha ;
                    rdfs:comment "Ladera donde parte de los ukumaris participa en una danza durante la parada en Yanaqancha."@es ;
                    rdfs:label "Cerro de Yanaqancha"@es .


###  http://example.org/festividades#Lomada
qr:Lomada rdf:type owl:NamedIndividual ,
                   qr:PracticaCultural ;
          qr:formaParteDe qr:FestividadQoylluriti ;
          qr:ocurreEn qr:SantuarioQoylluriti ,
                      qr:Tayancani ,
                      qr:Wataskama ,
                      qr:Yanaqancha ;
          qr:seRealizaEnRuta qr:RutaLomada ;
          qr:sigueA qr:DescensoColquePunku ;
          qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_047_01 ,
                                 qr:Medio_QR_FOT_2025_047_02 ,
                                 qr:Medio_QR_FOT_2025_047_03 ,
                                 qr:Medio_QR_FOT_2025_047_04 ,
                                 qr:Medio_QR_FOT_2025_047_05 ,
                                 qr:Medio_QR_FOT_2025_047_06 ,
                                 qr:Medio_QR_FOT_2025_047_07 ,
                                 qr:Medio_QR_FOT_2025_047_08 ,
                                 qr:Medio_QR_FOT_2025_047_09 ,
                                 qr:Medio_QR_FOT_2025_047_10 ,
                                 qr:Medio_QR_FOT_2025_047_11 ,
                                 qr:Medio_QR_FOT_2025_047_12 ,
                                 qr:Medio_QR_FOT_2025_047_13 ,
                                 qr:Medio_QR_FOT_2025_047_14 ,
                                 qr:Medio_QR_FOT_2025_047_15 ,
                                 qr:Medio_QR_FOT_2025_047_16 ,
                                 qr:Medio_QR_FOT_2025_047_17 ,
                                 qr:Medio_QR_FOT_2025_047_18 ,
                                 qr:Medio_QR_FOT_2025_047_19 ;
          rdfs:comment "La Lomada comienza en el Santuario después del descenso desde Colque Punku. Al amanecer los Qollas suben a encontrarse con los ukumaris que bajan; luego se inician los desplazamientos de la ruta de aproximadamente 24 horas. Ukumaris, Qollas y Chunchus de Paucartambo avanzan en un recorrido compartido, con sus músicas, descansos y encuentros. La ruta pasa por Wataskama y Yanaqancha y continúa de noche hacia Tayankani, con el paso exigente por Escalerachayoq. En el camino también se reconocen los hitos de Machu Cruz, Q’espi Cruz, Qquchiyoc Wayq’o y Yanaqocha. En 2025 se observó una bajada hacia Yanaqancha con terreno de apariencia pantanosa y una parada de altura en Q’espi Cruz. La dificultad de la caminata limita la posibilidad de tomar fotografías durante todos sus momentos."@es ;
          rdfs:label "Lomada, camino de las 24 horas"@es .


###  http://example.org/festividades#LosaHuascarCarpapampa
qr:LosaHuascarCarpapampa rdf:type owl:NamedIndividual ,
                                  qr:Lugar ;
                         qr:ubicadoEn qr:Carpapampa ;
                         rdfs:comment "Lugar del ensayo general de las danzas antes de la salida de Paucartambo."@es ;
                         rdfs:label "Losa deportiva Huáscar"@es .


