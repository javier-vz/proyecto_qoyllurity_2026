@prefix qr: <http://example.org/festividades#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qr26: <urn:qoylluriti:registro2026:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/festividades#anioRegistro
qr:anioRegistro rdf:type owl:AnnotationProperty .


###  http://example.org/festividades#identificadorMedio
qr:identificadorMedio rdf:type owl:AnnotationProperty .


###  http://example.org/festividades#tipoMedio
qr:tipoMedio rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/festividades#cierraRecorrido
qr:cierraRecorrido rdf:type owl:ObjectProperty ;
                   rdfs:comment "Celebración que cierra la secuencia vivida del recorrido de Paucartambo."@es ;
                   rdfs:label "cierra recorrido"@es .


###  http://example.org/festividades#continuaHacia
qr:continuaHacia rdf:type owl:ObjectProperty ;
                 rdfs:comment "Relación de continuidad entre lugares o rutas de un recorrido conocido."@es ;
                 rdfs:label "continúa hacia"@es .


###  http://example.org/festividades#formaParteDe
qr:formaParteDe rdf:type owl:ObjectProperty ;
                rdfs:comment "Relación entre agrupaciones, naciones y prácticas incluidas en una festividad."@es ;
                rdfs:label "forma parte de"@es .


###  http://example.org/festividades#incluyeRol
qr:incluyeRol rdf:type owl:ObjectProperty ;
              rdfs:comment "Rol desempeñado por integrantes de un colectivo."@es ;
              rdfs:label "incluye rol"@es .


###  http://example.org/festividades#incluyeRuta
qr:incluyeRuta rdf:type owl:ObjectProperty ;
               rdfs:comment "Vincula el itinerario general con sus caminos estables."@es ;
               rdfs:label "incluye ruta"@es .


###  http://example.org/festividades#iniciaEn
qr:iniciaEn rdf:type owl:ObjectProperty ;
            rdfs:comment "Lugar de inicio de una ruta."@es ;
            rdfs:label "inicia en"@es .


###  http://example.org/festividades#ocurreEn
qr:ocurreEn rdf:type owl:ObjectProperty ;
            rdfs:comment "Lugar reconocido de una práctica recurrente."@es ;
            rdfs:label "ocurre en"@es .


###  http://example.org/festividades#participaEn
qr:participaEn rdf:type owl:ObjectProperty ;
               rdfs:comment "Un colectivo participa en una práctica."@es ;
               rdfs:label "participa en"@es .


###  http://example.org/festividades#pasaPor
qr:pasaPor rdf:type owl:ObjectProperty ;
           rdfs:comment "Hito intermedio conocido de una ruta, sin imponer un orden cuando este no está establecido."@es ;
           rdfs:label "pasa por"@es .


###  http://example.org/festividades#recorre
qr:recorre rdf:type owl:ObjectProperty ;
           rdfs:comment "Colectivo que sigue una ruta en el recorrido descrito."@es ;
           rdfs:label "recorre"@es .


###  http://example.org/festividades#seRealizaEnRuta
qr:seRealizaEnRuta rdf:type owl:ObjectProperty ;
                   rdfs:comment "Práctica que se desarrolla a lo largo de un camino."@es ;
                   rdfs:label "se realiza en ruta"@es .


###  http://example.org/festividades#sigueA
qr:sigueA rdf:type owl:ObjectProperty ;
          rdfs:comment "Orden habitual entre prácticas en la secuencia local descrita."@es ;
          rdfs:label "sigue a"@es .


###  http://example.org/festividades#terminaEn
qr:terminaEn rdf:type owl:ObjectProperty ;
             rdfs:comment "Lugar de llegada de una ruta."@es ;
             rdfs:label "termina en"@es .


###  http://example.org/festividades#tieneRegistroVisual
qr:tieneRegistroVisual rdf:type owl:ObjectProperty ;
                       rdfs:comment "Vincula una práctica, lugar o ruta con el identificador de una imagen o video."@es ;
                       rdfs:label "tiene registro visual"@es .


###  http://example.org/festividades#tieneTramoGPS
qr:tieneTramoGPS rdf:type owl:ObjectProperty ;
                 rdfs:comment "Vincula una ruta conocida con un segmento de GPS registrado."@es ;
                 rdfs:label "tiene tramo GPS"@es .


###  http://example.org/festividades#ubicadoEn
qr:ubicadoEn rdf:type owl:ObjectProperty ;
             rdfs:comment "Un lugar, sector o referencia espacial se encuentra dentro de otro."@es ;
             rdfs:label "ubicado en"@es .


###  http://example.org/festividades#usaObjeto
qr:usaObjeto rdf:type owl:ObjectProperty ;
             rdfs:comment "Objeto empleado en una práctica."@es ;
             rdfs:label "usa objeto"@es .


###  http://example.org/festividades#vinculadoALugar
qr:vinculadoALugar rdf:type owl:ObjectProperty ;
                   rdfs:comment "Vínculo conocido de un colectivo con una localidad; no supone exclusividad territorial."@es ;
                   rdfs:label "vinculado a lugar"@es .


#################################################################
#    Data properties
#################################################################

###  http://example.org/festividades#archivoRelativo
qr:archivoRelativo rdf:type owl:DatatypeProperty ;
                   rdfs:label "Archivo multimedia relativo al directorio del TTL"@es .


###  http://example.org/festividades#identificadorGPS
qr:identificadorGPS rdf:type owl:DatatypeProperty ;
                    rdfs:label "Identificador GPS"@es .


###  http://example.org/festividades#inicioUTC
qr:inicioUTC rdf:type owl:DatatypeProperty ;
             rdfs:label "Inicio UTC"@es .


###  http://example.org/festividades#longitudKm
qr:longitudKm rdf:type owl:DatatypeProperty ;
              rdfs:label "Longitud del tramo, kilómetros"@es .


###  http://example.org/festividades#modalidad
qr:modalidad rdf:type owl:DatatypeProperty ;
             rdfs:label "Modalidad de desplazamiento"@es .


###  http://example.org/festividades#sha256
qr:sha256 rdf:type owl:DatatypeProperty ;
          rdfs:label "Huella SHA-256 de los bytes originales"@es .


#################################################################
#    Classes
#################################################################

###  http://example.org/festividades#AgrupacionDanza
qr:AgrupacionDanza rdf:type owl:Class ;
                   rdfs:subClassOf qr:Colectivo ;
                   rdfs:label "Agrupación de danza"@es .


###  http://example.org/festividades#Colectivo
qr:Colectivo rdf:type owl:Class ;
             rdfs:label "Colectivo de participantes"@es .


###  http://example.org/festividades#Festividad
qr:Festividad rdf:type owl:Class ;
              rdfs:label "Festividad"@es .


###  http://example.org/festividades#Lugar
qr:Lugar rdf:type owl:Class ;
         rdfs:label "Lugar o sector de referencia"@es .


###  http://example.org/festividades#MedioVisual
qr:MedioVisual rdf:type owl:Class .


###  http://example.org/festividades#Nacion
qr:Nacion rdf:type owl:Class ;
          rdfs:subClassOf qr:Colectivo ;
          rdfs:label "Nación de la peregrinación"@es .


###  http://example.org/festividades#Objeto
qr:Objeto rdf:type owl:Class ;
          rdfs:label "Objeto utilizado en las prácticas"@es .


###  http://example.org/festividades#PracticaCultural
qr:PracticaCultural rdf:type owl:Class ;
                    rdfs:label "Práctica cultural recurrente"@es .


###  http://example.org/festividades#Rol
qr:Rol rdf:type owl:Class ;
       rdfs:label "Rol de participación"@es .


###  http://example.org/festividades#Ruta
qr:Ruta rdf:type owl:Class ;
        rdfs:label "Camino o ruta reconocible"@es .


###  http://example.org/festividades#TramoGPS
qr:TramoGPS rdf:type owl:Class ;
            rdfs:label "Tramo de trayectoria GPS"@es .


#################################################################
#    Individuals
#################################################################

###  http://example.org/festividades#AscensoColquePunku
qr:AscensoColquePunku rdf:type owl:NamedIndividual ,
                               qr:PracticaCultural ;
                      qr:formaParteDe qr:FestividadQoylluriti ;
                      qr:ocurreEn qr:ColquePunku ,
                                  qr:GrutaColquePunku ;
                      qr:seRealizaEnRuta qr:RutaSantuarioColquePunku ;
                      qr:sigueA qr:PermanenciaSantuario ;
                      qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_041_01 ,
                                             qr:Medio_QR_FOT_2025_041_02 ,
                                             qr:Medio_QR_FOT_2025_041_03 ,
                                             qr:Medio_QR_FOT_2025_041_04 ,
                                             qr:Medio_QR_FOT_2025_041_05 ,
                                             qr:Medio_QR_FOT_2025_041_06 ,
                                             qr:Medio_QR_FOT_2025_042_01 ,
                                             qr:Medio_QR_FOT_2025_042_02 ,
                                             qr:Medio_QR_FOT_2025_042_03 ,
                                             qr:Medio_QR_FOT_2025_042_04 ,
                                             qr:Medio_QR_FOT_2025_042_05 ,
                                             qr:Medio_QR_FOT_2026_043_01 ,
                                             qr:Medio_QR_FOT_2026_043_02 ,
                                             qr:Medio_QR_FOT_2026_043_03 ,
                                             qr:Medio_QR_FOT_2026_043_04 ,
                                             qr:Medio_QR_FOT_2026_043_05 ,
                                             qr:Medio_QR_FOT_2026_043_06 ,
                                             qr:Medio_QR_FOT_2026_043_07 ,
                                             qr:Medio_QR_FOT_2026_043_08 ,
                                             qr:Medio_QR_FOT_2026_043_09 ,
                                             qr:Medio_QR_FOT_2026_043_10 ,
                                             qr:Medio_QR_FOT_2026_043_11 ,
                                             qr:Medio_QR_VID_2025_041_01 ;
                      qr:usaObjeto qr:BanderasNaciones ;
                      rdfs:comment "Los ukumaris ascienden de noche desde el Santuario, aproximadamente desde las once, y alcanzan el sector de Colque Punku cerca de las cuatro o cinco de la mañana. Se camina en altura con otras naciones y con banderas; durante la subida se distinguen las luces del Santuario y, en 2025, fuegos artificiales. En la zona del glaciar hay una gruta o sector de la cruz. La marcha, el frío, la altura y el esfuerzo son parte de la experiencia corporal de quienes participan. El sector mantiene su importancia aunque hayan cambiado las condiciones del hielo entre las observaciones de 2025 y 2026."@es ;
                      rdfs:label "Ascenso a Colque Punku"@es .


###  http://example.org/festividades#BanderasNaciones
qr:BanderasNaciones rdf:type owl:NamedIndividual ,
                             qr:Objeto ;
                    rdfs:comment "Banderas portadas por las agrupaciones y visibles en los encuentros de ukumaris, el ascenso y descenso de Colque Punku y el Inti Alabado."@es ;
                    rdfs:label "Banderas de las naciones"@es .


###  http://example.org/festividades#BautizoMorocos
qr:BautizoMorocos rdf:type owl:NamedIndividual ,
                           qr:PracticaCultural ;
                  qr:formaParteDe qr:FestividadQoylluriti ;
                  qr:ocurreEn qr:ColquePunku ,
                              qr:GrutaTayankani ;
                  qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_051_01 ,
                                         qr:Medio_QR_FOT_2025_051_02 ,
                                         qr:Medio_QR_FOT_2025_051_03 ,
                                         qr:Medio_QR_FOT_2025_051_04 ,
                                         qr:Medio_QR_FOT_2025_051_05 ;
                  qr:usaObjeto qr:Sorriago ;
                  rdfs:comment "Los morocos son integrantes en sus primeros años como ukumaris. Durante el ascenso a Colque Punku se realiza una iniciación en la que el moroco se arrodilla, recibe tres golpes con sorriago del caporal y después un abrazo. En el recorrido de Nación Paucartambo hay asimismo un momento de bautizo en la gruta de Tayankani, después del Inti Alabado. La experiencia de 2025 incluye el bautizo personal del participante en Tayankani. Los dos momentos se mencionan como parte de la trayectoria de los morocos; el modo preciso puede variar entre agrupaciones."@es ;
                  rdfs:label "Bautizo de morocos"@es .


###  http://example.org/festividades#CanchaOcongate
qr:CanchaOcongate rdf:type owl:NamedIndividual ,
                           qr:Lugar ;
                  qr:ubicadoEn qr:Ocongate ;
                  rdfs:comment "Espacio donde se reúnen los grupos al llegar desde Tayankani; hay público en las graderías y la espera continúa hasta la noche."@es ;
                  rdfs:label "Cancha de Ocongate"@es .


###  http://example.org/festividades#CantoQespiCruz
qr:CantoQespiCruz rdf:type owl:NamedIndividual ,
                           qr:PracticaCultural ;
                  qr:formaParteDe qr:FestividadQoylluriti ,
                                  qr:Lomada ;
                  qr:ocurreEn qr:QespiCruz ;
                  qr:seRealizaEnRuta qr:RutaLomada ;
                  rdfs:comment "Durante la noche, en Q’espi Cruz, la Nación canta la Canción de Despedida de los Qapaq Qollas. El camino atraviesa un sector alto donde los peregrinos se detienen antes de continuar."@es ;
                  rdfs:label "Canto en Q’espi Cruz"@es .


###  http://example.org/festividades#CapillaTayankani
qr:CapillaTayankani rdf:type owl:NamedIndividual ,
                             qr:Lugar ;
                    qr:ubicadoEn qr:Tayancani ;
                    rdfs:comment "Lugar en que permanece la imagen del Señor de Tayankani durante parte del calendario local."@es ;
                    rdfs:label "Capilla de Tayankani"@es .


###  http://example.org/festividades#Caporal
qr:Caporal rdf:type owl:NamedIndividual ,
                    qr:Rol ;
           rdfs:comment "Rol de conducción de la agrupación en determinadas actividades. En el bautizo de morocos se describe el uso del sorriago, seguido de un abrazo. En Wataskama los caporales participan en bromas durante los cruces."@es ;
           rdfs:label "Caporal"@es .


###  http://example.org/festividades#Carpapampa
qr:Carpapampa rdf:type owl:NamedIndividual ,
                       qr:Lugar ;
              qr:ubicadoEn qr:Paucartambo ;
              rdfs:comment "Barrio donde se ubica la losa Huáscar, lugar del ensayo general previo a la peregrinación."@es ;
              rdfs:label "Carpapampa, Paucartambo"@es .


###  http://example.org/festividades#Ccatcca
qr:Ccatcca rdf:type owl:NamedIndividual ,
                    qr:Lugar ;
           qr:continuaHacia qr:Ocongate ;
           qr:tieneRegistroVisual qr:Medio_QR_FOT_CCATCCA_034_01 ,
                                  qr:Medio_QR_FOT_CCATCCA_034_02 ,
                                  qr:Medio_QR_FOT_CCATCCA_034_03 ;
           rdfs:comment "Parada del viaje en la que se comparte comida. Se ha descrito la entrega de carne y maíz a personas del lugar."@es ;
           rdfs:label "Ccatcca"@es .


###  http://example.org/festividades#CeldaUkukusPaucartambo
qr:CeldaUkukusPaucartambo rdf:type owl:NamedIndividual ,
                                   qr:Lugar ;
                          qr:ubicadoEn qr:SantuarioQoylluriti ;
                          rdfs:comment "Espacio utilizado para dejar equipo, preparar comida y descansar en el sector del Santuario, próximo al sendero de subida a Colque Punku. Se encuentra en el entorno de bofedal."@es ;
                          rdfs:label "Celda de los ukumaris de Paucartambo"@es .


###  http://example.org/festividades#CementerioPaucartambo
qr:CementerioPaucartambo rdf:type owl:NamedIndividual ,
                                  qr:Lugar ;
                         qr:ubicadoEn qr:Paucartambo ;
                         rdfs:comment "La romería visita y recuerda a antiguos integrantes de las danzas y familiares fallecidos antes de iniciar el viaje."@es ;
                         rdfs:label "Cementerio de Paucartambo"@es .


###  http://example.org/festividades#ChunchusPaucartambo
qr:ChunchusPaucartambo rdf:type owl:NamedIndividual ,
                                qr:AgrupacionDanza ;
                       qr:formaParteDe qr:NacionPaucartambo ;
                       qr:participaEn qr:CantoQespiCruz ,
                                      qr:CorpusChristiPaucartambo ,
                                      qr:EncuentroWataskama ,
                                      qr:Lomada ,
                                      qr:PreparacionPaucartambo ,
                                      qr:ProcesionImagenTayankani ;
                       qr:recorre qr:RutaLomada ;
                       rdfs:comment "Agrupación de Nación Paucartambo que coincide con los ukumaris y Qollas en distintos momentos del camino y en celebraciones."@es ;
                       rdfs:label "Chunchus de Nación Paucartambo"@es .


###  http://example.org/festividades#ColquePunku
qr:ColquePunku rdf:type owl:NamedIndividual ,
                        qr:Lugar ;
               qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_042_01 ,
                                      qr:Medio_QR_FOT_2025_042_02 ,
                                      qr:Medio_QR_FOT_2025_042_03 ,
                                      qr:Medio_QR_FOT_2025_042_04 ,
                                      qr:Medio_QR_FOT_2025_042_05 ,
                                      qr:Medio_QR_FOT_2026_043_01 ,
                                      qr:Medio_QR_FOT_2026_043_02 ,
                                      qr:Medio_QR_FOT_2026_043_03 ,
                                      qr:Medio_QR_FOT_2026_043_04 ,
                                      qr:Medio_QR_FOT_2026_043_05 ,
                                      qr:Medio_QR_FOT_2026_043_06 ,
                                      qr:Medio_QR_FOT_2026_043_07 ,
                                      qr:Medio_QR_FOT_2026_043_08 ,
                                      qr:Medio_QR_FOT_2026_043_09 ,
                                      qr:Medio_QR_FOT_2026_043_10 ,
                                      qr:Medio_QR_FOT_2026_043_11 ;
               rdfs:comment "Sector de alta montaña y glaciar alcanzado durante la noche desde el Santuario. En 2025 el descenso se realizó con abundante nieve; en 2026 se observó considerablemente menos nieve. La comparación es descriptiva de ambas experiencias."@es ;
               rdfs:label "Colque Punku"@es .


###  http://example.org/festividades#CorpusChristiPaucartambo
qr:CorpusChristiPaucartambo rdf:type owl:NamedIndividual ,
                                     qr:Festividad ;
                            qr:cierraRecorrido qr:ItinerarioPaucartambo ;
                            qr:ocurreEn qr:Paucartambo ;
                            qr:tieneRegistroVisual qr:Medio_QR_FOT_2026_053_01 ,
                                                   qr:Medio_QR_FOT_2026_053_02 ,
                                                   qr:Medio_QR_FOT_2026_053_03 ,
                                                   qr:Medio_QR_FOT_2026_053_04 ,
                                                   qr:Medio_QR_FOT_2026_053_05 ,
                                                   qr:Medio_QR_FOT_2026_053_06 ,
                                                   qr:Medio_QR_FOT_2026_053_07 ,
                                                   qr:Medio_QR_FOT_2026_053_08 ,
                                                   qr:Medio_QR_FOT_2026_053_09 ,
                                                   qr:Medio_QR_FOT_2026_053_10 ,
                                                   qr:Medio_QR_FOT_2026_053_11 ,
                                                   qr:Medio_QR_FOT_2026_053_12 ,
                                                   qr:Medio_QR_FOT_2026_053_13 ,
                                                   qr:Medio_QR_FOT_2026_053_14 ,
                                                   qr:Medio_QR_FOT_2026_053_15 ;
                            rdfs:comment "Por la mañana, después de que los peregrinos han regresado de Ocongate durante la madrugada y descansado, se celebra Corpus Christi por las calles de Paucartambo. Participan danzas que han vuelto al pueblo y también escolares de comunidades o localidades cercanas; en 2026 se observaron numerosos niños vestidos como distintas danzas, incluidos ukumaris. Se ven procesiones, andas con imágenes, música y público. En la secuencia de Nación Paucartambo, esta celebración marca el cierre vivido de Qoyllur Rit’i. Corpus Christi también se celebra en Cusco, donde tiene gran relevancia, y en Paucartambo adopta su celebración local."@es ;
                            rdfs:label "Corpus Christi en Paucartambo"@es .


###  http://example.org/festividades#CruzColquePunku
qr:CruzColquePunku rdf:type owl:NamedIndividual ,
                            qr:Objeto ;
                   rdfs:comment "La cruz es llevada hacia arriba, a la zona de gruta de Colque Punku, el día anterior a su descenso. Después, ukumaris de distintas naciones participan por turnos en transportarla hacia abajo. Durante el traslado pueden producirse juegos y disputas físicamente intensas entre los participantes."@es ;
                   rdfs:label "Cruz de Colque Punku"@es .


###  http://example.org/festividades#DescensoColquePunku
qr:DescensoColquePunku rdf:type owl:NamedIndividual ,
                                qr:PracticaCultural ;
                       qr:formaParteDe qr:FestividadQoylluriti ;
                       qr:ocurreEn qr:ColquePunku ,
                                   qr:SantuarioQoylluriti ;
                       qr:seRealizaEnRuta qr:RutaColquePunkuSantuario ;
                       qr:sigueA qr:AscensoColquePunku ;
                       qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_044_01 ,
                                              qr:Medio_QR_FOT_2025_044_02 ,
                                              qr:Medio_QR_FOT_2025_044_03 ,
                                              qr:Medio_QR_FOT_2025_044_04 ,
                                              qr:Medio_QR_FOT_2025_044_05 ,
                                              qr:Medio_QR_FOT_2025_044_06 ,
                                              qr:Medio_QR_FOT_2025_044_07 ,
                                              qr:Medio_QR_FOT_2025_044_08 ,
                                              qr:Medio_QR_FOT_2025_044_09 ,
                                              qr:Medio_QR_FOT_2025_044_10 ,
                                              qr:Medio_QR_FOT_2025_044_11 ,
                                              qr:Medio_QR_FOT_2025_044_12 ,
                                              qr:Medio_QR_FOT_2025_046_01 ,
                                              qr:Medio_QR_FOT_2025_046_02 ,
                                              qr:Medio_QR_FOT_2025_046_03 ,
                                              qr:Medio_QR_FOT_2026_045_01 ,
                                              qr:Medio_QR_FOT_2026_045_02 ,
                                              qr:Medio_QR_FOT_2026_045_03 ,
                                              qr:Medio_QR_VID_2025_044_01 ,
                                              qr:Medio_QR_VID_2025_046_01 ,
                                              qr:Medio_QR_VID_2025_046_02 ,
                                              qr:Medio_QR_VID_2025_046_03 ;
                       qr:usaObjeto qr:BanderasNaciones ;
                       rdfs:comment "Los grupos descienden al amanecer desde Colque Punku hacia el Santuario. Avanzan entre banderas y ukumaris de distintas naciones; cerca de la entrada se concentran las agrupaciones que bajan. En 2025 el descenso se realizó con abundante nieve, suelo congelado y luz de amanecer. En 2026 hubo un día soleado y mucha menos nieve visible. Durante esta bajada también circula la cruz trasladada entre las naciones."@es ;
                       rdfs:label "Descenso desde Colque Punku"@es .


###  http://example.org/festividades#DespedidaMachuCruz
qr:DespedidaMachuCruz rdf:type owl:NamedIndividual ,
                               qr:PracticaCultural ;
                      qr:formaParteDe qr:FestividadQoylluriti ,
                                      qr:Lomada ;
                      qr:ocurreEn qr:MachuCruz ;
                      qr:seRealizaEnRuta qr:RutaLomada ;
                      rdfs:comment "En el recorrido de la Lomada aparece Machu Cruz, donde se describe una pausa para compartir maíz y queso como despedida antes de seguir caminando. La pausa ocurre durante el desplazamiento y se continúa caminando después de compartir alimentos."@es ;
                      rdfs:label "Pausa de despedida en Machu Cruz"@es .


###  http://example.org/festividades#DespedidaYanaqocha
qr:DespedidaYanaqocha rdf:type owl:NamedIndividual ,
                               qr:PracticaCultural ;
                      qr:formaParteDe qr:FestividadQoylluriti ,
                                      qr:Lomada ;
                      qr:ocurreEn qr:Yanaqocha ;
                      qr:seRealizaEnRuta qr:RutaLomada ;
                      rdfs:comment "En la laguna Yanaqocha los integrantes de la Nación se despiden con carreras y abrazos durante la Lomada."@es ;
                      rdfs:label "Despedida en Yanaqocha"@es .


###  http://example.org/festividades#EncuentroWataskama
qr:EncuentroWataskama rdf:type owl:NamedIndividual ,
                               qr:PracticaCultural ;
                      qr:formaParteDe qr:FestividadQoylluriti ,
                                      qr:Lomada ;
                      qr:ocurreEn qr:RiachueloWataskama ,
                                  qr:Wataskama ;
                      qr:seRealizaEnRuta qr:RutaLomada ;
                      rdfs:comment "En Wataskama se encuentran las danzas de Nación Paucartambo. En el valle estrecho corre un riachuelo; las agrupaciones se ubican en orillas diferentes y cruzan corriendo por turnos. Hay juegos, bromas de los caporales y gestos de castigo fingido a quien pierde. La actividad ocurre dentro de la Lomada y se cuenta con descripciones directas del encuentro aunque no existan fotografías de ese momento."@es ;
                      rdfs:label "Encuentro en Wataskama"@es .


###  http://example.org/festividades#Escalerachayoq
qr:Escalerachayoq rdf:type owl:NamedIndividual ,
                           qr:Lugar ;
                  qr:continuaHacia qr:Tayancani ;
                  rdfs:comment "Sector de escalones de piedra del camino nocturno hacia Tayankani. La bajada es prolongada y exigente físicamente."@es ;
                  rdfs:label "Escalerachayoq"@es .


###  http://example.org/festividades#EscolaresCorpusChristi
qr:EscolaresCorpusChristi rdf:type owl:NamedIndividual ,
                                   qr:Colectivo ;
                          qr:participaEn qr:CorpusChristiPaucartambo ;
                          rdfs:comment "Escolares de localidades próximas que participan vestidos como diferentes danzas, entre ellas ukumaris. Las observaciones de 2026 incluyen numerosos niños."@es ;
                          rdfs:label "Escolares participantes en Corpus Christi de Paucartambo"@es .


###  http://example.org/festividades#FestividadQoylluriti
qr:FestividadQoylluriti rdf:type owl:NamedIndividual ,
                                 qr:Festividad ;
                        qr:seRealizaEnRuta qr:ItinerarioPaucartambo ;
                        qr:tieneRegistroVisual qr:Medio_QR_FOT_2026_DRON_0009 ,
                                               qr:Medio_QR_FOT_2026_DRON_0010 ,
                                               qr:Medio_QR_FOT_2026_DRON_0011 ,
                                               qr:Medio_QR_FOT_2026_DRON_0012 ,
                                               qr:Medio_QR_FOT_2026_DRON_0013 ,
                                               qr:Medio_QR_FOT_2026_DRON_0014 ,
                                               qr:Medio_QR_FOT_2026_DRON_0015 ,
                                               qr:Medio_QR_FOT_2026_DRON_0016 ,
                                               qr:Medio_QR_FOT_2026_DRON_0017 ,
                                               qr:Medio_QR_FOT_2026_DRON_0018 ,
                                               qr:Medio_QR_FOT_2026_DRON_0019 ,
                                               qr:Medio_QR_FOT_2026_DRON_0020 ,
                                               qr:Medio_QR_FOT_2026_DRON_0021 ,
                                               qr:Medio_QR_FOT_2026_DRON_0022 ,
                                               qr:Medio_QR_FOT_2026_DRON_0023 ,
                                               qr:Medio_QR_FOT_2026_DRON_0024 ,
                                               qr:Medio_QR_FOT_2026_DRON_0025 ,
                                               qr:Medio_QR_FOT_2026_DRON_0026 ,
                                               qr:Medio_QR_FOT_2026_DRON_0027 ,
                                               qr:Medio_QR_FOT_2026_DRON_0028 ;
                        rdfs:comment "La peregrinación conecta Paucartambo, Ccatcca, Ocongate, Mahuayani, el Santuario de Sinakara, Colque Punku y el recorrido de la Lomada hacia Tayankani. La experiencia aquí descrita corresponde principalmente al camino de Nación Paucartambo y sus agrupaciones. La secuencia incluye preparativos, romería, viaje en camiones, subida al Santuario y a Colque Punku, traslado de la cruz, Lomada, descanso en Yanaqancha e Inti Alabado, antes del regreso a Ocongate y Paucartambo. Los días ayudan a narrar el itinerario; los mismos lugares y prácticas permanecen reconocibles entre años."@es ;
                        rdfs:label "Qoyllur Rit’i"@es .


###  http://example.org/festividades#GrutaColquePunku
qr:GrutaColquePunku rdf:type owl:NamedIndividual ,
                             qr:Lugar ;
                    qr:ubicadoEn qr:ColquePunku ;
                    rdfs:comment "Sector de la cruz que se asciende previamente y se desciende después. Se distingue de la gruta utilizada por los ukumaris de Paucartambo en Tayankani."@es ;
                    rdfs:label "Gruta de Colque Punku"@es .


###  http://example.org/festividades#GrutaTayankani
qr:GrutaTayankani rdf:type owl:NamedIndividual ,
