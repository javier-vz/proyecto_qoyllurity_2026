###  http://example.org/festividades#Moroco
qr:Moroco rdf:type owl:NamedIndividual ,
                   qr:Rol ;
          rdfs:comment "Integrante de los primeros años entre los ukumaris, habitualmente los dos o tres primeros. Durante la Lomada, en especial en los primeros dos años, se encarga de trasladar queperinas y otros bultos a las zonas de descanso, mientras otros participan en actividades colectivas."@es ;
          rdfs:label "Moroco"@es .


###  http://example.org/festividades#NacionPaucartambo
qr:NacionPaucartambo rdf:type owl:NamedIndividual ,
                              qr:Nacion ;
                     qr:vinculadoALugar qr:Paucartambo ;
                     rdfs:comment "Colectivo de pertenencia que reúne agrupaciones participantes de la peregrinación. El nombre de la Nación identifica una organización colectiva, mientras que Paucartambo es también la localidad vinculada a su partida y regreso."@es ;
                     rdfs:label "Nación Paucartambo"@es .


###  http://example.org/festividades#Ocongate
qr:Ocongate rdf:type owl:NamedIndividual ,
                     qr:Lugar ;
            qr:continuaHacia qr:Mahuayani ;
            qr:tieneRegistroVisual qr:Medio_QR_FOT_ANO_PEND_052_01 ,
                                   qr:Medio_QR_FOT_ANO_PEND_052_02 ,
                                   qr:Medio_QR_FOT_ANO_PEND_052_03 ,
                                   qr:Medio_QR_FOT_ANO_PEND_052_04 ,
                                   qr:Medio_QR_FOT_ANO_PEND_052_05 ;
            rdfs:comment "Localidad atravesada en la ida a Mahuayani y alcanzada nuevamente después de Tayankani. Al regreso hay recibimiento, encuentro en la cancha y posterior partida nocturna en camión."@es ;
            rdfs:label "Ocongate"@es .


###  http://example.org/festividades#Pachakunapata
qr:Pachakunapata rdf:type owl:NamedIndividual ,
                          qr:Lugar ;
                 qr:ubicadoEn qr:SantuarioQoylluriti ;
                 rdfs:comment "Hito por el que se pasa durante el ingreso al Santuario."@es ;
                 rdfs:label "P’achakunapata"@es .


