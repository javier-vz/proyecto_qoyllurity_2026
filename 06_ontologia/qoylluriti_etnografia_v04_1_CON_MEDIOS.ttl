###  http://example.org/festividades#PermanenciaSantuario
qr:PermanenciaSantuario rdf:type owl:NamedIndividual ,
                                 qr:PracticaCultural ;
                        qr:formaParteDe qr:FestividadQoylluriti ;
                        qr:ocurreEn qr:CeldaUkukusPaucartambo ,
                                    qr:SantuarioQoylluriti ;
                        qr:sigueA qr:PreparacionPaucartambo ;
                        qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_040_02 ,
                                               qr:Medio_QR_FOT_2025_040_03 ,
                                               qr:Medio_QR_FOT_2025_040_04 ,
                                               qr:Medio_QR_FOT_2025_040_05 ,
                                               qr:Medio_QR_FOT_2025_040_06 ,
                                               qr:Medio_QR_VID_2025_040_01 ;
                        qr:usaObjeto qr:Queperina ;
                        rdfs:comment "Tras subir desde Mahuayani se llega al Santuario. Los ukumaris tienen un espacio de campamento en el sector alto, hacia el sendero de Colque Punku, cerca de un bofedal; allí dejan queperinas, carpas, bolsas de dormir y otros objetos, comen y descansan. Hay circulación continua de peregrinos, pequeñas instalaciones y puestos, así como actividades en la iglesia, antes del ascenso nocturno. Las fotografías de 2025 muestran momentos de ingreso y estancia en el templo; el campamento se conoce por el relato de la experiencia."@es ;
                        rdfs:label "Permanencia y descanso en el Santuario"@es .


###  http://example.org/festividades#PermanenciaYanaqancha
qr:PermanenciaYanaqancha rdf:type owl:NamedIndividual ,
                                  qr:PracticaCultural ;
                         qr:formaParteDe qr:FestividadQoylluriti ,
                                         qr:Lomada ;
                         qr:ocurreEn qr:LaderaYanaqancha ,
                                     qr:Yanaqancha ;
                         qr:seRealizaEnRuta qr:RutaLomada ;
                         qr:sigueA qr:EncuentroWataskama ;
                         qr:tieneRegistroVisual qr:Medio_QR_MED_SF_049_01 ,
                                                qr:Medio_QR_MED_SF_049_02 ,
                                                qr:Medio_QR_MED_SF_049_03 ,
                                                qr:Medio_QR_MED_SF_049_04 ,
                                                qr:Medio_QR_MED_SF_049_05 ,
                                                qr:Medio_QR_MED_SF_049_06 ,
                                                qr:Medio_QR_MED_SF_049_07 ,
                                                qr:Medio_QR_MED_SF_049_08 ,
                                                qr:Medio_QR_MED_SF_049_09 ,
                                                qr:Medio_QR_MED_SF_049_10 ,
                                                qr:Medio_QR_MED_SF_049_11 ,
                                                qr:Medio_QR_MED_SF_049_12 ;
                         qr:usaObjeto qr:Queperina ;
                         rdfs:comment "Yanaqancha es una parada de la Lomada a la que se llega después de una bajada, en un paisaje donde el terreno parece húmedo o pantanoso. Los peregrinos comen, descansan brevemente y dejan equipaje en los sectores de campamento. Los morocos de los primeros años, especialmente durante los dos primeros, transportan las queperinas y otras pertenencias a los espacios de descanso. Mientras tanto otros ukumaris participan en una danza por el cerro. En 2025 se registraron filas subiendo por la ladera, toldos, banderas y personas reunidas. Tras el descanso, la marcha se retoma de noche o madrugada; el nombre exacto de esa danza aún no ha sido fijado."@es ;
                         rdfs:label "Descanso y actividades en Yanaqancha"@es .


###  http://example.org/festividades#PlazaCcatcca
qr:PlazaCcatcca rdf:type owl:NamedIndividual ,
                         qr:Lugar ;
                qr:ubicadoEn qr:Ccatcca ;
                rdfs:comment "Espacio referido en el registro histórico para el descanso y la comida compartida durante el viaje."@es ;
                rdfs:label "Plaza de Ccatcca"@es .


###  http://example.org/festividades#PlazaOcongate
qr:PlazaOcongate rdf:type owl:NamedIndividual ,
                          qr:Lugar ;
                 qr:ubicadoEn qr:Ocongate ;
                 rdfs:comment "Plaza de Ocongate, uno de los espacios del pueblo por los que circulan agrupaciones y peregrinos en su regreso."@es ;
                 rdfs:label "Plaza de Ocongate"@es .


###  http://example.org/festividades#PlazaPaucartambo
qr:PlazaPaucartambo rdf:type owl:NamedIndividual ,
                             qr:Lugar ;
                    qr:ubicadoEn qr:Paucartambo ;
                    rdfs:comment "Espacio público vinculado a las actividades de preparación y recorridos urbanos."@es ;
                    rdfs:label "Plaza de Paucartambo"@es .


###  http://example.org/festividades#PoblacionOcongate
qr:PoblacionOcongate rdf:type owl:NamedIndividual ,
                              qr:Colectivo ;
                     qr:vinculadoALugar qr:Ocongate ;
                     rdfs:comment "Personas del pueblo que reciben a los peregrinos en el tramo de retorno desde Tayankani; se relata alegría y ofrecimiento de chicha a los grupos que llegan."@es ;
                     rdfs:label "Población de Ocongate"@es .


###  http://example.org/festividades#PreparacionPaucartambo
qr:PreparacionPaucartambo rdf:type owl:NamedIndividual ,
                                   qr:PracticaCultural ;
                          qr:formaParteDe qr:FestividadQoylluriti ;
                          qr:ocurreEn qr:Carpapampa ,
                                      qr:IglesiaPaucartambo ,
                                      qr:Paucartambo ;
                          qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_030_01 ,
                                                 qr:Medio_QR_FOT_2025_030_02 ,
                                                 qr:Medio_QR_FOT_2025_030_03 ,
                                                 qr:Medio_QR_FOT_2025_030_04 ,
                                                 qr:Medio_QR_FOT_2025_031_01 ,
                                                 qr:Medio_QR_FOT_2025_031_02 ,
                                                 qr:Medio_QR_FOT_2025_031_03 ,
                                                 qr:Medio_QR_FOT_2025_031_04 ,
                                                 qr:Medio_QR_FOT_2025_031_05 ,
                                                 qr:Medio_QR_FOT_2025_031_06 ,
                                                 qr:Medio_QR_FOT_2026_031_01 ,
                                                 qr:Medio_QR_VID_2025_031_01 ;
                          rdfs:comment "El sábado anterior a la salida se realiza un ensayo general en la losa deportiva Huáscar del barrio Carpapampa. El domingo hay misa en la iglesia y romería al cementerio para visitar a integrantes antiguos de las danzas y familiares fallecidos. Los ukumaris se visten y se reúnen en el pueblo, recorren y corren por sus calles y pasan por la iglesia antes de organizar el transporte. Cada agrupación realiza sus preparativos y los ukumaris suben juntos a un camión, con otros vehículos de apoyo para mamawairis, cocina y equipaje. En esta etapa se reconoce el trabajo compartido antes de partir a Mahuayani."@es ;
                          rdfs:label "Preparación y salida desde Paucartambo"@es .


###  http://example.org/festividades#Prioste
qr:Prioste rdf:type owl:NamedIndividual ,
                    qr:Rol ;
           rdfs:comment "Rol asociado a la acogida y organización de una parada del viaje, donde coinciden integrantes de diversas agrupaciones."@es ;
           rdfs:label "Prioste"@es .


###  http://example.org/festividades#ProcesionImagenTayankani
qr:ProcesionImagenTayankani rdf:type owl:NamedIndividual ,
                                     qr:PracticaCultural ;
                            qr:formaParteDe qr:FestividadQoylluriti ;
                            qr:ocurreEn qr:CapillaTayankani ,
                                        qr:Mamachapata ,
                                        qr:Ocongate ,
                                        qr:SantuarioQoylluriti ;
                            qr:usaObjeto qr:ImagenSenorTayankani ;
                            rdfs:comment "La imagen del Señor de Tayankani es llevada en procesiones por distintos sectores del camino. El recorrido incluye el paso por Mamachapata, la capilla de Tayankani y el traslado hacia Ocongate. Son momentos de una práctica procesional continua con varios lugares vinculados."@es ;
                            rdfs:label "Procesiones de la imagen del Señor de Tayankani"@es .


###  http://example.org/festividades#QespiCruz
qr:QespiCruz rdf:type owl:NamedIndividual ,
                      qr:Lugar ;
             rdfs:comment "Hito alto de paso y descanso en la Lomada, también llamado Quespi Cruz. Desde el recorrido se contempla el paisaje de montaña; queda por precisar si es uno de los últimos puntos desde donde se observa el glaciar."@es ;
             rdfs:label "Q’espi Cruz"@es .


###  http://example.org/festividades#QollasPaucartambo
qr:QollasPaucartambo rdf:type owl:NamedIndividual ,
                              qr:AgrupacionDanza ;
                     qr:formaParteDe qr:NacionPaucartambo ;
                     qr:participaEn qr:CantoQespiCruz ,
                                    qr:CorpusChristiPaucartambo ,
                                    qr:EncuentroWataskama ,
                                    qr:Lomada ,
                                    qr:PreparacionPaucartambo ,
                                    qr:ProcesionImagenTayankani ;
                     qr:recorre qr:RutaLomada ;
                     rdfs:comment "Agrupación de Nación Paucartambo que participa en el recorrido. En el inicio de la Lomada los Qollas suben al encuentro de quienes descienden desde Colque Punku."@es ;
                     rdfs:label "Qollas de Nación Paucartambo"@es .


###  http://example.org/festividades#QquchiyocWayqo
qr:QquchiyocWayqo rdf:type owl:NamedIndividual ,
                           qr:Lugar ;
                  rdfs:comment "Quebrada con un riachuelo en el camino de la Lomada, en el sector comprendido entre Yanaqancha y Q’espi Cruz."@es ;
                  rdfs:label "Qquchiyoc Wayq’o"@es .


###  http://example.org/festividades#Queperina
qr:Queperina rdf:type owl:NamedIndividual ,
                      qr:Objeto ;
             rdfs:comment "Tela o bulto usado para cargar pertenencias a la espalda. Los morocos trasladan queperinas durante la caminata y, de modo destacado, hacia los espacios de descanso en Yanaqancha."@es ;
             rdfs:label "Queperina"@es .


###  http://example.org/festividades#RiachueloWataskama
qr:RiachueloWataskama rdf:type owl:NamedIndividual ,
                               qr:Lugar ;
                      qr:ubicadoEn qr:Wataskama ;
                      rdfs:comment "Referencia física del lugar donde se corre y se cruza de una orilla a otra durante el encuentro."@es ;
                      rdfs:label "Riachuelo de Wataskama"@es .


###  http://example.org/festividades#RomeriaPaucartambo
qr:RomeriaPaucartambo rdf:type owl:NamedIndividual ,
                               qr:PracticaCultural ;
                      qr:formaParteDe qr:FestividadQoylluriti ,
                                      qr:PreparacionPaucartambo ;
                      qr:ocurreEn qr:CementerioPaucartambo ;
                      rdfs:comment "Después de la misa y antes de la partida se visita el cementerio de Paucartambo. Allí se recuerda a los integrantes de las danzas que ya murieron, a los antiguos y a los familiares fallecidos. La visita es parte de la preparación del grupo, antes de regresar a las calles y salir en camiones."@es ;
                      rdfs:label "Romería en Paucartambo"@es .


###  http://example.org/festividades#RutaColquePunkuSantuario
qr:RutaColquePunkuSantuario rdf:type owl:NamedIndividual ,
                                     qr:Ruta ;
                            qr:iniciaEn qr:ColquePunku ;
                            qr:terminaEn qr:SantuarioQoylluriti ;
                            qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_044_01 ,
                                                   qr:Medio_QR_FOT_2025_044_02 ,
                                                   qr:Medio_QR_FOT_2025_044_03 ,
                                                   qr:Medio_QR_FOT_2025_044_04 ,
                                                   qr:Medio_QR_FOT_2025_044_05 ,
                                                   qr:Medio_QR_FOT_2025_044_06 ,
                                                   qr:Medio_QR_FOT_2025_044_07 ,
                                                   qr:Medio_QR_FOT_2025_044_08 ,
                                                   qr:Medio_QR_FOT_2025_044_09 ,
                                                   qr:Medio_QR_FOT_2025_044_10 ,
                                                   qr:Medio_QR_FOT_2025_044_11 ,
                                                   qr:Medio_QR_FOT_2025_044_12 ,
                                                   qr:Medio_QR_VID_2025_044_01 ;
                            qr:tieneTramoGPS qr26:Tramo06 ;
                            rdfs:comment "Descenso desde el sector del glaciar hacia el Santuario. Se reúnen ukumaris de diferentes naciones, con numerosas banderas. El regreso puede realizarse sobre nieve y suelo congelado, como se vivió en 2025, o con mucha menos nieve visible, como se observó en 2026."@es ;
                            rdfs:label "Camino de descenso de Colque Punku al Santuario"@es .


###  http://example.org/festividades#RutaLomada
qr:RutaLomada rdf:type owl:NamedIndividual ,
                       qr:Ruta ;
              qr:iniciaEn qr:SantuarioQoylluriti ;
              qr:pasaPor qr:Escalerachayoq ,
                         qr:MachuCruz ,
                         qr:QespiCruz ,
                         qr:QquchiyocWayqo ,
                         qr:Wataskama ,
                         qr:Yanaqancha ,
                         qr:Yanaqocha ;
              qr:terminaEn qr:Tayancani ;
              qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_047_01 ,
                                     qr:Medio_QR_FOT_2025_047_02 ,
                                     qr:Medio_QR_FOT_2025_047_03 ,
                                     qr:Medio_QR_FOT_2025_047_04 ,
                                     qr:Medio_QR_FOT_2025_047_05 ,
                                     qr:Medio_QR_FOT_2025_047_06 ,
                                     qr:Medio_QR_FOT_2025_047_07 ,
                                     qr:Medio_QR_FOT_2025_047_08 ,
                                     qr:Medio_QR_FOT_2025_047_09 ,
                                     qr:Medio_QR_FOT_2025_047_10 ,
                                     qr:Medio_QR_FOT_2025_047_11 ,
                                     qr:Medio_QR_FOT_2025_047_12 ,
                                     qr:Medio_QR_FOT_2025_047_13 ,
                                     qr:Medio_QR_FOT_2025_047_14 ,
                                     qr:Medio_QR_FOT_2025_047_15 ,
                                     qr:Medio_QR_FOT_2025_047_16 ,
                                     qr:Medio_QR_FOT_2025_047_17 ,
                                     qr:Medio_QR_FOT_2025_047_18 ,
                                     qr:Medio_QR_FOT_2025_047_19 ;
              qr:tieneTramoGPS qr26:Tramo07 ,
                               qr26:Tramo08 ,
                               qr26:Tramo09 ;
              rdfs:comment "Camino de unas 24 horas que comienza en el Santuario después del descenso de Colque Punku y sigue hacia Tayankani. En el recorrido se encuentran Wataskama, Yanaqancha, Q’espi Cruz, Yanaqocha, Machu Cruz y el paso por Escalerachayoq, aunque las posiciones de ciertos hitos secundarios aún deben fijarse con el GPS y la memoria de campo. La marcha combina sectores abiertos, bajadas pronunciadas, descansos cortos y un tramo nocturno muy exigente."@es ;
              rdfs:label "Ruta de la Lomada"@es .


###  http://example.org/festividades#RutaMahuayaniSantuario
qr:RutaMahuayaniSantuario rdf:type owl:NamedIndividual ,
                                   qr:Ruta ;
                          qr:iniciaEn qr:Mahuayani ;
                          qr:terminaEn qr:SantuarioQoylluriti ;
                          qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_038_01 ,
                                                 qr:Medio_QR_FOT_2025_038_02 ,
                                                 qr:Medio_QR_FOT_2025_038_03 ,
                                                 qr:Medio_QR_FOT_2025_038_04 ,
                                                 qr:Medio_QR_FOT_2025_038_05 ,
                                                 qr:Medio_QR_FOT_2025_038_06 ,
                                                 qr:Medio_QR_FOT_2025_038_07 ,
                                                 qr:Medio_QR_FOT_2025_038_08 ,
                                                 qr:Medio_QR_FOT_2026_036_03 ,
                                                 qr:Medio_QR_FOT_2026_036_04 ,
                                                 qr:Medio_QR_FOT_2026_036_05 ,
                                                 qr:Medio_QR_FOT_2026_036_06 ,
                                                 qr:Medio_QR_VID_2026_036_01 ;
                          qr:tieneTramoGPS qr26:Tramo04 ;
                          rdfs:comment "El camino se inicia entre camiones, puestos de comida y peregrinos con pertenencias. Desde poco después de Mahuayani puede verse el pueblo desde arriba. Los ukumaris cargan carpas, bolsas de dormir, vestimenta y comida; los morocos llevan también leña y otros bultos en esta etapa. Parte de la carga puede subir en caballos. La llegada conduce al sector del Santuario."@es ;
                          rdfs:label "Camino de Mahuayani al Santuario"@es .


###  http://example.org/festividades#RutaOcongatePaucartambo
qr:RutaOcongatePaucartambo rdf:type owl:NamedIndividual ,
                                    qr:Ruta ;
                           qr:iniciaEn qr:Ocongate ;
                           qr:terminaEn qr:Paucartambo ;
                           rdfs:comment "Desde Ocongate se regresa en camión durante la noche. Los participantes llegan a Paucartambo de madrugada y descansan. A la mañana siguiente se celebra Corpus Christi por las calles del pueblo."@es ;
                           rdfs:label "Camino de regreso de Ocongate a Paucartambo"@es .


###  http://example.org/festividades#RutaPaucartamboMahuayani
qr:RutaPaucartamboMahuayani rdf:type owl:NamedIndividual ,
                                     qr:Ruta ;
                            qr:iniciaEn qr:Paucartambo ;
                            qr:pasaPor qr:Ccatcca ,
                                       qr:Huancarani ,
                                       qr:Ocongate ;
                            qr:terminaEn qr:Mahuayani ;
                            qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_035_01 ,
                                                   qr:Medio_QR_FOT_2025_035_02 ,
                                                   qr:Medio_QR_FOT_2025_035_03 ,
                                                   qr:Medio_QR_FOT_2026_036_01 ,
                                                   qr:Medio_QR_FOT_2026_036_02 ,
                                                   qr:Medio_QR_FOT_2026_036_03 ,
                                                   qr:Medio_QR_FOT_2026_036_04 ,
                                                   qr:Medio_QR_FOT_2026_036_05 ,
                                                   qr:Medio_QR_FOT_2026_036_06 ,
                                                   qr:Medio_QR_FOT_CCATCCA_034_01 ,
                                                   qr:Medio_QR_FOT_CCATCCA_034_02 ,
                                                   qr:Medio_QR_FOT_CCATCCA_034_03 ,
                                                   qr:Medio_QR_VID_2026_036_01 ;
                            qr:tieneTramoGPS qr26:Tramo01 ,
                                             qr26:Tramo02 ,
                                             qr26:Tramo03 ,
                                             qr26:Tramo12 ;
                            rdfs:comment "El grupo parte de Paucartambo en camiones. En el trayecto se pasa por Huancarani, Ccatcca y Ocongate antes de llegar a Mahuayani. Los ukumaris viajan en conjunto y las mamawairis apoyan el transporte y las tareas de alimentación. En Ccatcca se comparte carne y maíz con población local; se visita una iglesia y se descansa. También se recuerda una parada en casa de un prioste, donde se encuentran ukumaris, Qollas y Chunchus."@es ;
                            rdfs:label "Camino de Paucartambo a Mahuayani"@es .


###  http://example.org/festividades#RutaSantuarioColquePunku
qr:RutaSantuarioColquePunku rdf:type owl:NamedIndividual ,
                                     qr:Ruta ;
                            qr:iniciaEn qr:SantuarioQoylluriti ;
                            qr:terminaEn qr:ColquePunku ;
                            qr:tieneRegistroVisual qr:Medio_QR_FOT_2025_041_01 ,
                                                   qr:Medio_QR_FOT_2025_041_02 ,
                                                   qr:Medio_QR_FOT_2025_041_03 ,
                                                   qr:Medio_QR_FOT_2025_041_04 ,
                                                   qr:Medio_QR_FOT_2025_041_05 ,
                                                   qr:Medio_QR_FOT_2025_041_06 ,
                                                   qr:Medio_QR_VID_2025_041_01 ;
                            qr:tieneTramoGPS qr26:Tramo05 ;
                            rdfs:comment "Ascenso nocturno desde el Santuario hasta el sector de Colque Punku. Desde la altura se ven las luces del Santuario y en algunas ocasiones fuegos artificiales. Se asciende con banderas; la marcha es físicamente exigente y se llega antes o cerca del amanecer."@es ;
                            rdfs:label "Camino del Santuario a Colque Punku"@es .


###  http://example.org/festividades#RutaTayankaniOcongate
qr:RutaTayankaniOcongate rdf:type owl:NamedIndividual ,
                                  qr:Ruta ;
                         qr:iniciaEn qr:Tayancani ;
                         qr:terminaEn qr:Ocongate ;
                         qr:tieneRegistroVisual qr:Medio_QR_FOT_ANO_PEND_052_01 ,
                                                qr:Medio_QR_FOT_ANO_PEND_052_02 ,
                                                qr:Medio_QR_FOT_ANO_PEND_052_03 ,
                                                qr:Medio_QR_FOT_ANO_PEND_052_04 ,
                                                qr:Medio_QR_FOT_ANO_PEND_052_05 ;
                         qr:tieneTramoGPS qr26:Tramo10 ,
                                          qr26:Tramo11 ;
                         rdfs:comment "Después del Inti Alabado se continúa a pie hacia Ocongate. La gente del pueblo recibe a las agrupaciones con alegría; también se ofrece chicha. En la cancha se reúnen los grupos y el público ocupa las graderías. Allí se permanece hasta la noche."@es ;
                         rdfs:label "Camino de Tayankani a Ocongate"@es .


