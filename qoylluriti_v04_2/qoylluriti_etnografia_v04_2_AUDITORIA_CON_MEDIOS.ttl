qr:Lomada a qr:PracticaCultural ;
    rdfs:label "Lomada, camino de las 24 horas"@es ;
    qr:formaParteDe qr:FestividadQoylluriti ;
    qr:ocurreEn qr:SantuarioQoylluriti,
        qr:Tayancani,
